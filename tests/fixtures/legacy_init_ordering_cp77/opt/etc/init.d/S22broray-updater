#!/opt/bin/ash

ENABLED=yes
DAEMON=/opt/libexec/broray-updater/broray-updater.sh
PIDFILE=/opt/var/lib/broray-updater/daemon.pid
LOGFILE=/opt/var/lib/broray-updater/updater.log

pid_valid()
{
    pid="$(sed -n '1p' "$PIDFILE" 2>/dev/null || true)"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 0
    command_line="$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    case "$command_line" in *broray-updater*daemon*) return 0 ;; esac
    return 1
}

start()
{
    [ "$ENABLED" = yes ] || return 0
    pid_valid && {
        printf 'BROray updater уже запущен, PID %s\n' "$(sed -n '1p' "$PIDFILE")"
        return 0
    }

    [ -x "$DAEMON" ] || {
        printf 'Не найден updater: %s\n' "$DAEMON" >&2
        return 1
    }

    mkdir -p "${PIDFILE%/*}" || return 1
    /opt/bin/ash "$DAEMON" daemon >>"$LOGFILE" 2>&1 </dev/null &
    launched=$!

    wait_round=0
    while [ "$wait_round" -lt 10 ]
    do
        wait_round=$((wait_round + 1))
        pid_valid && {
            printf 'BROray updater запущен, PID %s\n' "$(sed -n '1p' "$PIDFILE")"
            return 0
        }
        kill -0 "$launched" 2>/dev/null || break
        sleep 1
    done

    printf '%s\n' 'Ошибка запуска BROray updater' >&2
    return 1
}

stop()
{
    if ! pid_valid; then
        printf '%s\n' 'BROray updater не запущен'
        return 0
    fi

    pid="$(sed -n '1p' "$PIDFILE")"
    kill "$pid" 2>/dev/null || true

    wait_round=0
    while kill -0 "$pid" 2>/dev/null && [ "$wait_round" -lt 10 ]
    do
        wait_round=$((wait_round + 1))
        sleep 1
    done

    kill -0 "$pid" 2>/dev/null && return 1
    printf '%s\n' 'BROray updater остановлен'
}

status()
{
    if pid_valid; then
        printf 'BROray updater работает, PID %s\n' "$(sed -n '1p' "$PIDFILE")"
        return 0
    fi
    printf '%s\n' 'BROray updater не запущен'
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) status ;;
    *) printf '%s\n' 'Использование: S22broray-updater {start|stop|restart|status}' >&2; exit 2 ;;
esac
