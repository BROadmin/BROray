#!/opt/bin/ash

PATH="/opt/broray/bin:/opt/sbin:/opt/bin:/sbin:/bin"
export PATH

ROOT="${BRORAY_ROOT:-/opt/broray}"
. "$ROOT/lib/subscription-service.sh"

PID_FILE="${BRORAY_SUBSCRIPTION_PIDFILE:-$ROOT/run/subscription-scheduler.pid}"
STARTTIME_FILE="${BRORAY_SUBSCRIPTION_STARTTIME_FILE:-$ROOT/run/subscription-scheduler.starttime}"
LOG_FILE="${BRORAY_SUBSCRIPTION_LOG_FILE:-$ROOT/logs/subscription-scheduler.log}"
PROC_ROOT="${BRORAY_SUBSCRIPTION_PROC_ROOT:-/proc}"
INTERVAL_SECONDS="${BRORAY_SUB_SCHEDULER_INTERVAL:-60}"
GLOBAL_LOCK="${BRORAY_SUBSCRIPTION_GLOBAL_LOCK:-/opt/var/lock/broray/global-operation.lock}"
UPDATER_LOCK="${BRORAY_SUBSCRIPTION_UPDATER_LOCK:-/opt/var/lib/broray-updater/request.lock}"
SYSTEM_LOCK="${BRORAY_SUBSCRIPTION_SYSTEM_LOCK:-/tmp/broray-global-operation.lock}"
ROUTES_OPERATIONS="${BRORAY_SUBSCRIPTION_ROUTES_OPERATIONS:-$ROOT/routes/operations}"
GLOBAL_HELD=false
OWN_STARTTIME=""

process_starttime()
{
    scheduler_pid="$1"
    awk 'NR==1 { print $22; exit }' "$PROC_ROOT/$scheduler_pid/stat" 2>/dev/null
}

identity_matches()
{
    scheduler_pid="$1"
    scheduler_start="$2"
    case "$scheduler_pid:$scheduler_start" in
        *[!0-9:]*|:|*:) return 1 ;;
    esac
    kill -0 "$scheduler_pid" 2>/dev/null || return 1
    [ "$(process_starttime "$scheduler_pid")" = "$scheduler_start" ]
}

write_one()
{
    scheduler_path="$1"
    scheduler_value="$2"
    scheduler_temporary="$scheduler_path.new.$$"
    printf '%s\n' "$scheduler_value" >"$scheduler_temporary" || return 1
    chmod 600 "$scheduler_temporary" 2>/dev/null || true
    mv -f "$scheduler_temporary" "$scheduler_path"
}

routes_resumable_pending()
{
    local operation_file
    [ -d "$ROUTES_OPERATIONS" ] || return 1
    for operation_file in "$ROUTES_OPERATIONS"/*.json; do
        [ -f "$operation_file" ] && [ ! -L "$operation_file" ] || continue
        jq -e 'type=="object" and .kind=="routes" and .running==false and .resumable==true and (.bundleId|type)=="string" and (.bundleId|length)>0' \
            "$operation_file" >/dev/null 2>&1 && return 0
    done
    return 1
}

scheduler_cleanup()
{
    if [ "$GLOBAL_HELD" = true ] &&
       [ "$(sed -n '1p' "$GLOBAL_LOCK/pid" 2>/dev/null || true)" = "$$" ]; then
        rm -rf "$GLOBAL_LOCK" 2>/dev/null || true
    fi
    GLOBAL_HELD=false
    recorded_pid="$(sed -n '1p' "$PID_FILE" 2>/dev/null)"
    recorded_start="$(sed -n '1p' "$STARTTIME_FILE" 2>/dev/null)"
    if [ "$recorded_pid" = "$$" ] && [ -n "$OWN_STARTTIME" ] && [ "$recorded_start" = "$OWN_STARTTIME" ]; then
        rm -f "$PID_FILE" "$STARTTIME_FILE"
    fi
}

scheduler_cycle()
{
    [ ! -d "$UPDATER_LOCK" ] || return 0
    [ ! -d "$SYSTEM_LOCK" ] || return 0
    ! routes_resumable_pending || return 0
    mkdir -p "${GLOBAL_LOCK%/*}" || return 1
    mkdir "$GLOBAL_LOCK" 2>/dev/null || return 0
    printf '%s\n' "$$" >"$GLOBAL_LOCK/pid" &&
    printf '%s\n' system >"$GLOBAL_LOCK/scope" &&
    printf '%s\n' subscriptions:scheduler >"$GLOBAL_LOCK/action" &&
    : >"$GLOBAL_LOCK/bundle" &&
    printf '%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$GLOBAL_LOCK/startedAt" || {
        rm -rf "$GLOBAL_LOCK"
        return 1
    }
    GLOBAL_HELD=true
    if [ -d "$UPDATER_LOCK" ] || [ -d "$SYSTEM_LOCK" ] || routes_resumable_pending; then
        rm -rf "$GLOBAL_LOCK"
        GLOBAL_HELD=false
        return 0
    fi
    broray_subscription_scheduler_once
    cycle_rc=$?
    if [ "$(sed -n '1p' "$GLOBAL_LOCK/pid" 2>/dev/null || true)" = "$$" ]; then
        rm -rf "$GLOBAL_LOCK"
    fi
    GLOBAL_HELD=false
    return "$cycle_rc"
}

mkdir -p "${PID_FILE%/*}" "${LOG_FILE%/*}"
OWN_STARTTIME="$(process_starttime "$$")"
[ -n "$OWN_STARTTIME" ] || exit 1
existing_pid="$(sed -n '1p' "$PID_FILE" 2>/dev/null)"
existing_start="$(sed -n '1p' "$STARTTIME_FILE" 2>/dev/null)"
if [ "$existing_pid" != "$$" ] && identity_matches "$existing_pid" "$existing_start"; then
    printf 'scheduler already running pid=%s starttime=%s\n' "$existing_pid" "$existing_start" >&2
    exit 1
fi
write_one "$PID_FILE" "$$" || exit 1
write_one "$STARTTIME_FILE" "$OWN_STARTTIME" || exit 1
trap 'scheduler_cleanup' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

while :; do
    if ! scheduler_cycle >>"$LOG_FILE" 2>&1; then
        printf '%s scheduler cycle failed\n' \
            "$(broray_subscription_now_iso)" >>"$LOG_FILE"
    fi
    sleep "$INTERVAL_SECONDS"
done
