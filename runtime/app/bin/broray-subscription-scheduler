#!/opt/bin/ash

ROOT="${BRORAY_ROOT:-/opt/broray}"
PATH="$ROOT/bin:/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

. "$ROOT/lib/subscription-service.sh"

LOG_FILE="${BRORAY_SUBSCRIPTION_LOG_FILE:-$ROOT/logs/subscription-scheduler.log}"
INTERVAL_SECONDS="${BRORAY_SUB_SCHEDULER_INTERVAL:-60}"
BRORAY_ROUTES_API_LOCK="${BRORAY_SUBSCRIPTION_GLOBAL_LOCK:-${BRORAY_ROUTES_API_LOCK:-/opt/var/lock/broray/global-operation.lock}}"
export BRORAY_ROUTES_API_LOCK
. "$ROOT/lib/service-lifecycle.sh"

scheduler_cycle()
{
    local due_file due_now
    due_now="$(broray_subscription_now_epoch)"
    for due_file in "$BRORAY_SUB_DIR"/*.json; do
        [ -f "$due_file" ] && [ ! -L "$due_file" ] || continue
        if jq -e --argjson now "$due_now" '.enabled==true and .autoUpdateEnabled==true and
          (.nextUpdateEpoch|type)=="number" and .nextUpdateEpoch>0 and .nextUpdateEpoch<=$now' "$due_file" >/dev/null 2>&1; then
            # A fresh exec has its own PID/birth identity and exit traps. The
            # daemon cannot be mistaken for a completed or hung update job.
            broray_service_run_job "$ROOT/bin/broray-subscription-scheduler" --job
            return $?
        fi
    done
    return 0
}

case "${1:-}" in
    --job)
        job_rc=0
        broray_job_begin system subscriptions:scheduler subscriptions SUBSCRIPTION_AUTO cooperative || job_rc=$?
        [ "$job_rc" != 2 ] || exit 0
        [ "$job_rc" = 0 ] || exit "$job_rc"
        trap 'broray_job_exit "$?"' EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        broray_subscription_scheduler_once
        exit $? ;;
    --once) scheduler_cycle; exit $? ;;
    '') ;;
    *) exit 64 ;;
esac

broray_service_daemon_enter subscriptions || exit $?
mkdir -p "${LOG_FILE%/*}" || exit 74
trap 'broray_service_daemon_exit' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

while :; do
    broray_service_stop_requested && break
    if ! scheduler_cycle >>"$LOG_FILE" 2>&1; then
        printf '%s scheduler cycle failed\n' \
            "$(broray_subscription_now_iso)" >>"$LOG_FILE"
    fi
    broray_service_sleep "$INTERVAL_SECONDS" || break
done
exit 0
