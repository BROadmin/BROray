#!/opt/bin/ash
set -u
ROOT="${BRORAY_ROOT:-/opt/broray}"
LIB="${BRORAY_DOT_LIB:-$ROOT/lib/routes-dot.sh}"
[ -f "$LIB" ] && [ ! -L "$LIB" ] && [ -r "$LIB" ] || {
  echo 'BRORAY_ERROR:MODULE_UNAVAILABLE:Модуль DNS-over-TLS недоступен.' >&2
  exit 1
}
. "$LIB"
# Both CGI and standalone work use the existing protected route supervisor.
# An inherited PID/token alone is not permission: the worker must be present
# in the exact native child ledger for this action and bundle.
broray_dot_cli_locked()
{
    local action worker result
    action="$1"
    shift
    worker="$1"
    shift
    . "$ROOT/lib/route-job.sh" || return 1
    if [ -n "${BRORAY_BACKGROUND_OPERATION_ID:-}" ]; then
        broray_route_cli_worker_check "dot:$action" dns-over-tls || return 73
    else
        result=0
        broray_route_job_run "dot:$action" dns-over-tls "${BRORAY_OPS_ASH:-/opt/bin/ash}" \
          "$ROOT/bin/broray-routes-dot" "$action" "$@" || result=$?
        if [ "$result" = 2 ]; then
            broray_dot_error ROUTES_OPERATION_BUSY "Другая конфликтующая операция уже выполняется."
        fi
        return "$result"
    fi
    "$worker" "$@"
}

case "${1:-}" in
  status) broray_dot_status ;;
  status-cached) broray_dot_status_cached ;;
  test) [ -n "${2:-}" ] || { broray_dot_error REQUEST_INVALID "Не указан файл запроса."; exit 1; }; broray_dot_cli_locked test broray_dot_test "$2" ;;
  apply) [ -n "${2:-}" ] || { broray_dot_error REQUEST_INVALID "Не указан файл запроса."; exit 1; }; broray_dot_cli_locked apply broray_dot_apply "$2" ;;
  delete-preview) broray_dot_cli_locked delete-preview broray_dot_delete_preview ;;
  delete) [ -n "${2:-}" ] || { broray_dot_error REQUEST_INVALID "Не указан файл подтверждения удаления."; exit 1; }; broray_dot_cli_locked delete broray_dot_delete "$2" ;;
  *) echo 'Использование: broray-routes-dot {status|status-cached|test REQUEST.json|apply REQUEST.json|delete-preview|delete REQUEST.json}' >&2; exit 2 ;;
esac
