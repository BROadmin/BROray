#!/opt/bin/ash
PATH="${BRORAY_ROOT:-/opt/broray}/bin:/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
. "${BRORAY_ROOT:-/opt/broray}/lib/service-lifecycle.sh" || exit 74
broray_service_setup "${1:-}" || exit $?
action="${2:-}"
case "$action" in
  status-json) broray_service_status_json ;;
  status)
    view="$(broray_service_status_json)" || exit 74
    printf '%s\n' "$view"
    printf '%s\n' "$view" | jq -e '.complete and .running==true' >/dev/null ;;
  start)
    view="$(broray_service_status_json)" || exit 74
    if ! printf '%s\n' "$view" | jq -e '.complete' >/dev/null; then
        "$SVC_ASH" "$SVC_APP/bin/broray-service" "$SVC_NAME" recover || {
            broray_service_status_json; exit 75;
        }
        view="$(broray_service_status_json)" || exit 74
        printf '%s\n' "$view" | jq -e '.complete' >/dev/null || { printf '%s\n' "$view"; exit 75; }
    fi
    if ! printf '%s\n' "$view" | jq -e '.running==true' >/dev/null; then
        [ -f "$SVC_DAEMON" ] && [ ! -L "$SVC_DAEMON" ] || exit 74
        mkdir -p "$SVC_APP/logs" || exit 74
        "$SVC_ASH" "$SVC_DAEMON" >>"$SVC_LOG" 2>&1 </dev/null &
    fi
    # One launch, elapsed uptime budget including status probes, fresh final
    # readiness observation. Wall-clock/NTP adjustments cannot extend it.
    read -r started unused < /proc/uptime || exit 74
    deadline=$(( ${started%%.*} + 180 ))
    while :; do
        view="$(broray_service_status_json)" || exit 74
        if printf '%s\n' "$view" | jq -e '.complete and .ready' >/dev/null; then printf '%s\n' "$view"; exit 0; fi
        read -r now unused < /proc/uptime || exit 74
        [ "${now%%.*}" -lt "$deadline" ] || break
        sleep 1
    done
    printf '%s\n' "$view"; exit 75 ;;
  stop)
    broray_service_control stop || exit $?
    # A cooperative snapshot can still be finishing a large configuration
    # read. Observe the same stop request; return as soon as its lifetime is
    # drained, including a fresh probe after the final one-second wait.
    remaining=120
    while :; do
        view="$(broray_service_status_json)" || exit 74
        if printf '%s\n' "$view" | jq -e '.complete and .running==false' >/dev/null; then
            # Wait for inherited short-lived writers too. No success while an
            # older lifetime lease can still inhibit a replacement daemon.
            "$SVC_GUARD" "$SVC_DIR/lifetime.guard" "$SVC_ASH" "$SVC_APP/bin/broray-service" "$SVC_NAME" retire-dead || exit 75
            printf '%s\n' "$view"; exit 0
        fi
        [ "$remaining" -gt 0 ] || break
        sleep 1
        remaining=$((remaining-1))
    done
    printf '%s\n' "$view"; exit 75 ;;
  retire-dead)
    broray_service_fd "$SVC_DIR/lifetime.guard" >/dev/null || exit 73
    broray_service_control retire-dead ;;
  recover)
    broray_service_dirs || exit $?
    exec "$SVC_GUARD" "$SVC_DIR/lifetime.guard" "$SVC_ASH" "$SVC_APP/bin/broray-service" "$SVC_NAME" recover-held ;;
  recover-held)
    broray_service_fd "$SVC_DIR/lifetime.guard" >/dev/null || exit 73
    broray_service_control recover ;;
  restart)
    "$SVC_ASH" "$SVC_APP/bin/broray-service" "$SVC_NAME" stop || exit $?
    exec "$SVC_ASH" "$SVC_APP/bin/broray-service" "$SVC_NAME" start ;;
  *) exit 64 ;;
esac
