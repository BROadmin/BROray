#!/opt/bin/ash

BRORAY_ROOT="${BRORAY_ROOT:-/opt/broray}"
PATH="$BRORAY_ROOT/bin:/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export BRORAY_ROOT PATH
. "$BRORAY_ROOT/lib/server-service.sh"

server_worker()
{
    exec "${BRORAY_OPS_ASH:-/opt/bin/ash}" "$BRORAY_ROOT/lib/server-job-worker.sh" "$@"
}

command_name="${1:-summary}"

case "$command_name" in
    summary|list)
        broray_server_summary
        ;;
    show)
        shift
        broray_server_details "${1:-}"
        ;;
    import)
        shift
        server_worker import broray_server_import "${1:-}" manual "" 0
        ;;
    check)
        shift
        server_worker check broray_server_check "${1:-}" "${2:-manual}"
        ;;
    activate|use)
        shift
        server_worker activate broray_server_activate "${1:-}"
        ;;
    deactivate|disable)
        server_worker deactivate broray_server_deactivate
        ;;
    delete)
        shift
        server_worker delete broray_server_delete_safe "${1:-}"
        ;;
    *)
        cat >&2 <<'USAGE'
Использование:
  broray-servers summary
  broray-servers show <SERVER_ID>
  broray-servers import <URI>
  broray-servers check <SERVER_ID> [manual|auto-switch|scheduled]
  broray-servers activate <SERVER_ID>
  broray-servers deactivate
  broray-servers delete <SERVER_ID>
USAGE
        exit 1
        ;;
esac
