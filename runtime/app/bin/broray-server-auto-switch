#!/opt/bin/ash

ROOT="${BRORAY_ROOT:-/opt/broray}"
PATH="$ROOT/bin:/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

set +e
set +u

CONFIG="$ROOT/config/system/server-auto-switch.json"
STATE="$ROOT/run/server-auto-switch-state.json"
ACTIVE_SERVER_FILE="$ROOT/config/active-server"
LOG="$ROOT/logs/server-auto-switch.log"
LOCK="$ROOT/run/server-auto-switch-cycle.lock"
GLOBAL_LOCK="${BRORAY_GLOBAL_LOCK:-/opt/var/lock/broray/global-operation.lock}"
UPDATER_LOCK="${BRORAY_UPDATER_LOCK:-/opt/var/lib/broray-updater/request.lock}"
SYSTEM_LOCK="${BRORAY_SYSTEM_LOCK:-/tmp/broray-global-operation.lock}"
ROUTES_OPERATIONS="$ROOT/routes/operations"
BRORAY_ROUTES_API_LOCK="$GLOBAL_LOCK"
BRORAY_LEGACY_GLOBAL_LOCK="$SYSTEM_LOCK"
BRORAY_SERVER_SKIP_KEENETIC_REFRESH=true
export BRORAY_ROUTES_API_LOCK BRORAY_LEGACY_GLOBAL_LOCK BRORAY_SERVER_SKIP_KEENETIC_REFRESH
. "$ROOT/lib/server-service.sh"
umask 077

routes_resumable_pending()
{
    local operation_file
    [ -d "$ROUTES_OPERATIONS" ] || return 1
    for operation_file in "$ROUTES_OPERATIONS"/*.json; do
        [ -f "$operation_file" ] && [ ! -L "$operation_file" ] || continue
        jq -e 'type=="object" and .kind=="routes" and .running==false and .resumable==true and (.bundleId|type)=="string" and (.bundleId|length)>0' \
            "$operation_file" >/dev/null 2>&1 && return 0
    done
    return 1
}

SERVERS_BIN="$ROOT/bin/broray-servers"
BRORAY_BIN="$ROOT/bin/broray"
MONITOR_STATUS="$ROOT/run/connection-status.json"
MONITOR_PIDFILE="$ROOT/run/connection-monitor.pid"
UPDATE_LOCK="${BRORAY_XRAY_UPDATE_LOCK:-$ROOT/run/xray-update/xray.lock}"
HOME_SNAPSHOT="${BRORAY_HOME_SNAPSHOT_REFRESH:-$ROOT/bin/broray-home-snapshot}"

MODE="daemon"
DRY_RUN=false
INTERVAL_SECONDS=15
ATTEMPT_GUARD_SECONDS=60
STATE_HEARTBEAT_SECONDS=60

case "${1:-}" in
    --job) MODE=job ;;
    --job-dry-run) MODE=job; DRY_RUN=true ;;
    --once)
        MODE="once"
        ;;

    --dry-run)
        MODE="once"
        DRY_RUN=true
        ;;

    --once-dry-run)
        MODE="once"
        DRY_RUN=true
        ;;
esac

mkdir -p \
    "$ROOT/run" \
    "$ROOT/logs" \
    "$ROOT/tmp" \
    "$ROOT/config/system"

now_iso()
{
    date '+%Y-%m-%dT%H:%M:%S%z'
}

log_message()
{
    MESSAGE="$*"

    if [ -f "$LOG" ]; then
        SIZE="$(wc -c < "$LOG" 2>/dev/null | tr -d ' ')"

        case "$SIZE" in
            ''|*[!0-9]*)
                SIZE=0
                ;;
        esac

        if [ "$SIZE" -gt 262144 ]; then
            tail -n 600 "$LOG" > "$LOG.new" 2>/dev/null &&
                mv "$LOG.new" "$LOG"
        fi
    fi

    printf '%s %s\n' "$(now_iso)" "$MESSAGE" >> "$LOG"
}

rating_rank()
{
    case "$1" in
        excellent)
            echo 4
            ;;

        good)
            echo 3
            ;;

        acceptable)
            echo 2
            ;;

        poor)
            echo 1
            ;;

        *)
            echo 0
            ;;
    esac
}

load_config()
{
    CFG_ENABLED=false
    CFG_THRESHOLD=3
    CFG_COOLDOWN=10
    CFG_MINIMUM="acceptable"
    CFG_RULE="best-quality"
    CFG_PREFERRED=""
    CFG_QUALITY_ENABLED=false
    CFG_QUALITY_INTERVAL=60

    if ! jq -e 'type == "object"' "$CONFIG" >/dev/null 2>&1; then
        return
    fi

    CFG_ENABLED="$(jq -r '.enabled // false' "$CONFIG")"
    CFG_THRESHOLD="$(jq -r '.failureThreshold // 3' "$CONFIG")"
    CFG_COOLDOWN="$(jq -r '.cooldownMinutes // 10' "$CONFIG")"
    CFG_MINIMUM="$(jq -r '.minimumRating // "acceptable"' "$CONFIG")"
    CFG_RULE="$(jq -r '.selectionRule // "best-quality"' "$CONFIG")"
    CFG_PREFERRED="$(jq -r '.preferredServerId // empty' "$CONFIG")"
    CFG_QUALITY_ENABLED="$(jq -r '.qualityRefreshEnabled // false' "$CONFIG")"
    CFG_QUALITY_INTERVAL="$(jq -r '.qualityRefreshIntervalMinutes // 60' "$CONFIG")"

    case "$CFG_ENABLED" in
        true|false)
            ;;

        *)
            CFG_ENABLED=false
            ;;
    esac

    case "$CFG_THRESHOLD" in
        ''|*[!0-9]*)
            CFG_THRESHOLD=3
            ;;
    esac

    if [ "$CFG_THRESHOLD" -lt 1 ] ||
       [ "$CFG_THRESHOLD" -gt 10 ]
    then
        CFG_THRESHOLD=3
    fi

    case "$CFG_COOLDOWN" in
        ''|*[!0-9]*)
            CFG_COOLDOWN=10
            ;;
    esac

    if [ "$CFG_COOLDOWN" -lt 1 ] ||
       [ "$CFG_COOLDOWN" -gt 120 ]
    then
        CFG_COOLDOWN=10
    fi

    case "$CFG_MINIMUM" in
        excellent|good|acceptable|poor)
            ;;

        *)
            CFG_MINIMUM="acceptable"
            ;;
    esac

    case "$CFG_RULE" in
        best-quality|lowest-ping|preferred)
            ;;

        *)
            CFG_RULE="best-quality"
            ;;
    esac

    case "$CFG_QUALITY_ENABLED" in
        true|false)
            ;;

        *)
            CFG_QUALITY_ENABLED=false
            ;;
    esac

    case "$CFG_QUALITY_INTERVAL" in
        30|60|180|360)
            ;;

        *)
            CFG_QUALITY_INTERVAL=60
            ;;
    esac
}

load_state()
{
    S_ENABLED=false
    S_STATUS="initializing"
    S_ACTIVE_ID=""
    S_FAILURES=0
    S_MONITOR_FINGERPRINT=""
    S_LAST_EVALUATION_AT=""
    S_LAST_EVALUATION_EPOCH=0
    S_LAST_ATTEMPT_EPOCH=0
    S_LAST_ATTEMPT_AT=""
    S_LAST_SWITCH_EPOCH=0
    S_LAST_SWITCH_AT=""
    S_LAST_SWITCH_FROM=""
    S_LAST_SWITCH_TO=""
    S_LAST_SWITCH_NAME=""
    S_LAST_REASON=""
    S_LAST_ERROR=""
    S_CANDIDATE_COUNT=0
    S_Q_STATUS="disabled"
    S_Q_INTERVAL=60
    S_Q_RUN_STARTED_AT=""
    S_Q_LAST_COMPLETED_AT=""
    S_Q_NEXT_EPOCH=0
    S_Q_TOTAL=0
    S_Q_CHECKED=0
    S_Q_AVAILABLE=0
    S_Q_UNAVAILABLE=0
    S_Q_ERRORS=0
    S_Q_LAST_RESULT=""
    S_Q_LAST_ERROR=""

    if ! jq -e 'type == "object"' "$STATE" >/dev/null 2>&1; then
        return
    fi

    S_ENABLED="$(jq -r '.enabled // false' "$STATE")"
    S_STATUS="$(jq -r '.status // "initializing"' "$STATE")"
    S_ACTIVE_ID="$(jq -r '.activeServerId // empty' "$STATE")"
    S_FAILURES="$(jq -r '.consecutiveFailures // 0' "$STATE")"
    S_MONITOR_FINGERPRINT="$(jq -r '.lastMonitorFingerprint // empty' "$STATE")"
    S_LAST_EVALUATION_AT="$(jq -r '.lastEvaluationAt // empty' "$STATE")"
    S_LAST_EVALUATION_EPOCH="$(jq -r '.lastEvaluationEpoch // 0' "$STATE")"
    S_LAST_ATTEMPT_EPOCH="$(jq -r '.lastAttemptEpoch // 0' "$STATE")"
    S_LAST_ATTEMPT_AT="$(jq -r '.lastAttemptAt // empty' "$STATE")"
    S_LAST_SWITCH_EPOCH="$(jq -r '.lastSwitchEpoch // 0' "$STATE")"
    S_LAST_SWITCH_AT="$(jq -r '.lastSwitchAt // empty' "$STATE")"
    S_LAST_SWITCH_FROM="$(jq -r '.lastSwitchFrom // empty' "$STATE")"
    S_LAST_SWITCH_TO="$(jq -r '.lastSwitchTo // empty' "$STATE")"
    S_LAST_SWITCH_NAME="$(jq -r '.lastSwitchName // empty' "$STATE")"
    S_LAST_REASON="$(jq -r '.lastReason // empty' "$STATE")"
    S_LAST_ERROR="$(jq -r '.lastError // empty' "$STATE")"
    S_CANDIDATE_COUNT="$(jq -r '.candidateCount // 0' "$STATE")"
    S_Q_STATUS="$(jq -r '.qualityRefresh.status // "disabled"' "$STATE")"
    S_Q_INTERVAL="$(jq -r '.qualityRefresh.intervalMinutes // 60' "$STATE")"
    S_Q_RUN_STARTED_AT="$(jq -r '.qualityRefresh.runStartedAt // empty' "$STATE")"
    S_Q_LAST_COMPLETED_AT="$(jq -r '.qualityRefresh.lastCompletedAt // empty' "$STATE")"
    S_Q_NEXT_EPOCH="$(jq -r '.qualityRefresh.nextCheckEpoch // 0' "$STATE")"
    S_Q_TOTAL="$(jq -r '.qualityRefresh.totalCount // 0' "$STATE")"
    S_Q_CHECKED="$(jq -r '.qualityRefresh.checkedCount // 0' "$STATE")"
    S_Q_AVAILABLE="$(jq -r '.qualityRefresh.availableCount // 0' "$STATE")"
    S_Q_UNAVAILABLE="$(jq -r '.qualityRefresh.unavailableCount // 0' "$STATE")"
    S_Q_ERRORS="$(jq -r '.qualityRefresh.errorCount // 0' "$STATE")"
    S_Q_LAST_RESULT="$(jq -r '.qualityRefresh.lastResult // empty' "$STATE")"
    S_Q_LAST_ERROR="$(jq -r '.qualityRefresh.lastError // empty' "$STATE")"

    case "$S_FAILURES" in
        ''|*[!0-9]*) S_FAILURES=0 ;;
    esac

    case "$S_LAST_ATTEMPT_EPOCH" in
        ''|*[!0-9]*) S_LAST_ATTEMPT_EPOCH=0 ;;
    esac

    case "$S_LAST_EVALUATION_EPOCH" in
        ''|*[!0-9]*) S_LAST_EVALUATION_EPOCH=0 ;;
    esac

    case "$S_LAST_SWITCH_EPOCH" in
        ''|*[!0-9]*) S_LAST_SWITCH_EPOCH=0 ;;
    esac

    case "$S_CANDIDATE_COUNT" in
        ''|*[!0-9]*) S_CANDIDATE_COUNT=0 ;;
    esac

    for QUALITY_NUMBER in \
        S_Q_INTERVAL S_Q_NEXT_EPOCH S_Q_TOTAL S_Q_CHECKED \
        S_Q_AVAILABLE S_Q_UNAVAILABLE S_Q_ERRORS
    do
        eval "QUALITY_VALUE=\${$QUALITY_NUMBER}"
        case "$QUALITY_VALUE" in
            ''|*[!0-9]*) eval "$QUALITY_NUMBER=0" ;;
        esac
    done

    S_LOADED_SIGNATURE="$(state_signature)"
}

state_signature()
{
    {
        printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
            "$S_ENABLED" "$S_STATUS" "$S_ACTIVE_ID" "$S_FAILURES" \
            "$S_MONITOR_FINGERPRINT" "$S_LAST_ATTEMPT_EPOCH" "$S_LAST_ATTEMPT_AT" \
            "$S_LAST_SWITCH_EPOCH" "$S_LAST_SWITCH_AT" "$S_LAST_SWITCH_FROM" \
            "$S_LAST_SWITCH_TO" "$S_LAST_SWITCH_NAME" "$S_LAST_REASON" \
            "$S_LAST_ERROR" "$S_CANDIDATE_COUNT"
        printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
            "$S_Q_STATUS" "$S_Q_INTERVAL" "$S_Q_RUN_STARTED_AT" "$S_Q_LAST_COMPLETED_AT" \
            "$S_Q_NEXT_EPOCH" "$S_Q_TOTAL" "$S_Q_CHECKED" \
            "$S_Q_AVAILABLE" "$S_Q_UNAVAILABLE" "$S_Q_ERRORS" \
            "$S_Q_LAST_RESULT" "$S_Q_LAST_ERROR"
    } |
        sha256sum |
        awk '{print $1}'
}

save_state()
{
    broray_job_require_owner || exit $?
    broray_ops_cancel_requested && exit 130
    TMP="$STATE.new.$$"
    EVALUATION_EPOCH="${NOW_EPOCH:-$(date '+%s')}"
    CURRENT_SIGNATURE="$(state_signature)"

    if [ -f "$STATE" ] &&
       [ "$CURRENT_SIGNATURE" = "${S_LOADED_SIGNATURE:-}" ] &&
       [ "$S_LAST_EVALUATION_EPOCH" -gt 0 ]
    then
        EVALUATION_AGE=$((EVALUATION_EPOCH - S_LAST_EVALUATION_EPOCH))
        if [ "$EVALUATION_AGE" -ge 0 ] &&
           [ "$EVALUATION_AGE" -lt "$STATE_HEARTBEAT_SECONDS" ]
        then
            return 0
        fi
    fi

    S_LAST_EVALUATION_AT="$(now_iso)"
    S_LAST_EVALUATION_EPOCH="$EVALUATION_EPOCH"

    jq -n \
        --arg backgroundOperationId "$BRORAY_BACKGROUND_OPERATION_ID" \
        --argjson enabled "$S_ENABLED" \
        --arg status "$S_STATUS" \
        --arg activeServerId "$S_ACTIVE_ID" \
        --argjson consecutiveFailures "$S_FAILURES" \
        --arg lastMonitorFingerprint "$S_MONITOR_FINGERPRINT" \
        --arg lastEvaluationAt "$S_LAST_EVALUATION_AT" \
        --argjson lastEvaluationEpoch "$S_LAST_EVALUATION_EPOCH" \
        --argjson lastAttemptEpoch "$S_LAST_ATTEMPT_EPOCH" \
        --arg lastAttemptAt "$S_LAST_ATTEMPT_AT" \
        --argjson lastSwitchEpoch "$S_LAST_SWITCH_EPOCH" \
        --arg lastSwitchAt "$S_LAST_SWITCH_AT" \
        --arg lastSwitchFrom "$S_LAST_SWITCH_FROM" \
        --arg lastSwitchTo "$S_LAST_SWITCH_TO" \
        --arg lastSwitchName "$S_LAST_SWITCH_NAME" \
        --arg lastReason "$S_LAST_REASON" \
        --arg lastError "$S_LAST_ERROR" \
        --argjson candidateCount "$S_CANDIDATE_COUNT" \
        --arg qualityStatus "$S_Q_STATUS" \
        --argjson qualityIntervalMinutes "$S_Q_INTERVAL" \
        --arg qualityRunStartedAt "$S_Q_RUN_STARTED_AT" \
        --arg qualityLastCompletedAt "$S_Q_LAST_COMPLETED_AT" \
        --argjson qualityNextCheckEpoch "$S_Q_NEXT_EPOCH" \
        --argjson qualityTotalCount "$S_Q_TOTAL" \
        --argjson qualityCheckedCount "$S_Q_CHECKED" \
        --argjson qualityAvailableCount "$S_Q_AVAILABLE" \
        --argjson qualityUnavailableCount "$S_Q_UNAVAILABLE" \
        --argjson qualityErrorCount "$S_Q_ERRORS" \
        --arg qualityLastResult "$S_Q_LAST_RESULT" \
        --arg qualityLastError "$S_Q_LAST_ERROR" '
        {
            schemaVersion: 3,
            backgroundOperationId: $backgroundOperationId,
            enabled: $enabled,
            status: $status,

            activeServerId: (
                if $activeServerId == ""
                then null
                else $activeServerId
                end
            ),

            consecutiveFailures: $consecutiveFailures,

            lastMonitorFingerprint: (
                if $lastMonitorFingerprint == ""
                then null
                else $lastMonitorFingerprint
                end
            ),

            lastEvaluationAt: $lastEvaluationAt,
            lastEvaluationEpoch: $lastEvaluationEpoch,
            lastAttemptEpoch: $lastAttemptEpoch,

            lastAttemptAt: (
                if $lastAttemptAt == ""
                then null
                else $lastAttemptAt
                end
            ),

            lastSwitchEpoch: $lastSwitchEpoch,

            lastSwitchAt: (
                if $lastSwitchAt == ""
                then null
                else $lastSwitchAt
                end
            ),

            lastSwitchFrom: (
                if $lastSwitchFrom == ""
                then null
                else $lastSwitchFrom
                end
            ),

            lastSwitchTo: (
                if $lastSwitchTo == ""
                then null
                else $lastSwitchTo
                end
            ),

            lastSwitchName: (
                if $lastSwitchName == ""
                then null
                else $lastSwitchName
                end
            ),

            lastReason: (
                if $lastReason == ""
                then null
                else $lastReason
                end
            ),

            lastError: (
                if $lastError == ""
                then null
                else $lastError
                end
            ),

            candidateCount: $candidateCount,

            qualityRefresh: {
                status: $qualityStatus,
                intervalMinutes: $qualityIntervalMinutes,
                runStartedAt: (
                    if $qualityRunStartedAt == ""
                    then null
                    else $qualityRunStartedAt
                    end
                ),
                lastCompletedAt: (
                    if $qualityLastCompletedAt == ""
                    then null
                    else $qualityLastCompletedAt
                    end
                ),
                nextCheckEpoch: $qualityNextCheckEpoch,
                totalCount: $qualityTotalCount,
                checkedCount: $qualityCheckedCount,
                availableCount: $qualityAvailableCount,
                unavailableCount: $qualityUnavailableCount,
                errorCount: $qualityErrorCount,
                lastResult: (
                    if $qualityLastResult == ""
                    then null
                    else $qualityLastResult
                    end
                ),
                lastError: (
                    if $qualityLastError == ""
                    then null
                    else $qualityLastError
                    end
                )
            }
        }
    ' > "$TMP" || {
        rm -f "$TMP"
        return 1
    }

    chmod 0600 "$TMP" || exit 1
    broray_job_checkpoint committing || exit $?
    if ! "${BRORAY_OPS_GUARD:-$ROOT/bin/broray-ops-guard}" --replace-file "$TMP" "$STATE"; then
        BRORAY_JOB_UNRESOLVED=true; exit 75
    fi
    broray_job_checkpoint working || exit $?
    S_LOADED_SIGNATURE="$CURRENT_SIGNATURE"
}

monitor_state()
{
    MONITOR_HEALTH="unknown"
    MONITOR_FINGERPRINT=""

    MONITOR_PID="$(cat "$MONITOR_PIDFILE" 2>/dev/null || true)"

    if [ -z "$MONITOR_PID" ] ||
       ! kill -0 "$MONITOR_PID" 2>/dev/null
    then
        return
    fi

    if ! jq -e 'type == "object"' "$MONITOR_STATUS" >/dev/null 2>&1; then
        return
    fi

    MONITOR_HEALTH="$(
        jq -r '
            if ((.available | type) == "boolean")
            then (.available | tostring)
            elif ((.connected | type) == "boolean")
            then (.connected | tostring)
            elif ((.healthy | type) == "boolean")
            then (.healthy | tostring)
            else "unknown"
            end
        ' "$MONITOR_STATUS"
    )"

    MONITOR_FINGERPRINT="$(
        sha256sum "$MONITOR_STATUS" 2>/dev/null |
            awk '{print $1}'
    )"
}

build_candidates()
{
    SUMMARY_FILE="$1"
    CURRENT_ID="$2"
    OUT_ARRAY="$3"
    OUT_JSONL="$ROOT/tmp/auto-switch-candidates.$$.jsonl"

    rm -f "$OUT_JSONL" "$OUT_ARRAY"
    : > "$OUT_JSONL"

    MIN_RANK="$(rating_rank "$CFG_MINIMUM")"

    CANDIDATE_IDS="$ROOT/tmp/auto-switch-ids.$$.txt"
    jq -r '.servers[]?.id // empty' "$SUMMARY_FILE" >"$CANDIDATE_IDS" || return 1
    while IFS= read -r SERVER_ID
    do
        [ -n "$SERVER_ID" ] || continue
        [ "$SERVER_ID" != "$CURRENT_ID" ] || continue

        RESULT_FILE="$ROOT/tmp/auto-switch-check-$SERVER_ID.$$.json"
        ERROR_FILE="$ROOT/tmp/auto-switch-check-$SERVER_ID.$$.err"

        rm -f "$RESULT_FILE" "$ERROR_FILE"

        CANDIDATE_RC=0
        broray_server_check "$SERVER_ID" auto-switch >"$RESULT_FILE" 2>"$ERROR_FILE" || CANDIDATE_RC=$?
        case "$CANDIDATE_RC" in 130|124|75|73|74) return "$CANDIDATE_RC" ;; esac

        if ! jq -e '.success == true' "$RESULT_FILE" >/dev/null 2>&1; then
            rm -f "$RESULT_FILE" "$ERROR_FILE"
            continue
        fi

        RATING="$(jq -r '.quality.rating // "unavailable"' "$RESULT_FILE")"
        RANK="$(rating_rank "$RATING")"

        if [ "$RANK" -lt "$MIN_RANK" ]; then
            rm -f "$RESULT_FILE" "$ERROR_FILE"
            continue
        fi

        PING="$(jq -r '.quality.ping // 999999' "$RESULT_FILE")"
        JITTER="$(jq -r '.quality.jitter // 999999' "$RESULT_FILE")"

        case "$PING" in
            ''|*[!0-9]*) PING=999999 ;;
        esac

        case "$JITTER" in
            ''|*[!0-9]*) JITTER=999999 ;;
        esac

        NAME="$(
            jq -r \
                --arg id "$SERVER_ID" '
                first(.servers[] | select(.id == $id) | .name) // $id
                ' "$SUMMARY_FILE"
        )"

        jq -n -c \
            --arg id "$SERVER_ID" \
            --arg name "$NAME" \
            --arg rating "$RATING" \
            --argjson ratingRank "$RANK" \
            --argjson ping "$PING" \
            --argjson jitter "$JITTER" '
            {
                id: $id,
                name: $name,
                rating: $rating,
                ratingRank: $ratingRank,
                ping: $ping,
                jitter: $jitter
            }
        ' >> "$OUT_JSONL"

        rm -f "$RESULT_FILE" "$ERROR_FILE"
    done <"$CANDIDATE_IDS"
    rm -f "$CANDIDATE_IDS"

    if [ ! -s "$OUT_JSONL" ]; then
        printf '%s\n' '[]' > "$OUT_ARRAY"
        rm -f "$OUT_JSONL"
        return 1
    fi

    jq -s '.' "$OUT_JSONL" > "$OUT_ARRAY" || {
        rm -f "$OUT_JSONL" "$OUT_ARRAY"
        return 1
    }

    rm -f "$OUT_JSONL"
    return 0
}

select_candidate()
{
    CANDIDATE_FILE="$1"
    SELECTED_JSON="null"

    if [ "$CFG_RULE" = "preferred" ] &&
       [ -n "$CFG_PREFERRED" ]
    then
        SELECTED_JSON="$(
            jq -c \
                --arg id "$CFG_PREFERRED" '
                first(.[] | select(.id == $id)) // null
                ' "$CANDIDATE_FILE"
        )"
    fi

    if [ "$SELECTED_JSON" = "null" ]; then
        if [ "$CFG_RULE" = "lowest-ping" ]; then
            SELECTED_JSON="$(
                jq -c '
                    sort_by([.ping, (-.ratingRank), .jitter, .id])
                    | .[0] // null
                ' "$CANDIDATE_FILE"
            )"
        else
            SELECTED_JSON="$(
                jq -c '
                    sort_by([(-.ratingRank), .ping, .jitter, .id])
                    | .[0] // null
                ' "$CANDIDATE_FILE"
            )"
        fi
    fi

    [ "$SELECTED_JSON" != "null" ]
}

activate_candidate()
{
    CURRENT_ID="$1"
    SELECTED_ID="$2"
    SELECTED_NAME="$3"

    ACTIVATE_OUT="$ROOT/tmp/auto-switch-activate.$$.json"
    ACTIVATE_ERR="$ROOT/tmp/auto-switch-activate.$$.err"
    VERIFY_OUT="$ROOT/tmp/auto-switch-verify.$$.json"

    rm -f "$ACTIVATE_OUT" "$ACTIVATE_ERR" "$VERIFY_OUT"

    broray_server_activate "$SELECTED_ID" \
        > "$ACTIVATE_OUT" \
        2> "$ACTIVATE_ERR"

    ACTIVATE_RC="$?"
    BRORAY_JOB_UNRESOLVED=true

    sleep 3

    broray_server_summary > "$VERIFY_OUT" 2>/dev/null

    VERIFY_ID="$(jq -r '.activeServer.id // empty' "$VERIFY_OUT" 2>/dev/null)"
    VERIFY_XRAY="$(jq -r '.xrayRunning // false' "$VERIFY_OUT" 2>/dev/null)"
    VERIFY_SOCKS="$(
        broray_xray_status_json 2>/dev/null |
            jq -r '.data.socks.active // false' 2>/dev/null
    )"

    if [ "$ACTIVATE_RC" -eq 0 ] &&
       [ "$VERIFY_ID" = "$SELECTED_ID" ] &&
       [ "$VERIFY_XRAY" = "true" ] &&
       [ "$VERIFY_SOCKS" = "true" ]
    then
        BRORAY_JOB_UNRESOLVED=false
        rm -f "$ACTIVATE_OUT" "$ACTIVATE_ERR" "$VERIFY_OUT"
        return 0
    fi

    ERROR_TEXT="$(
        {
            cat "$ACTIVATE_ERR" 2>/dev/null
            cat "$ACTIVATE_OUT" 2>/dev/null
        } |
            tail -c 700
    )"

    [ -n "$ERROR_TEXT" ] ||
        ERROR_TEXT="Новый сервер не прошёл проверку после активации."

    if [ -n "$CURRENT_ID" ]; then
        log_message "Откат на предыдущий сервер $CURRENT_ID"
        broray_server_activate "$CURRENT_ID" >/dev/null 2>&1 || return 75
        BRORAY_JOB_UNRESOLVED=false
    fi

    S_LAST_ERROR="$ERROR_TEXT"

    rm -f "$ACTIVATE_OUT" "$ACTIVATE_ERR" "$VERIFY_OUT"
    return 1
}

quality_refresh_finish()
{
    QUALITY_FINISHED_EPOCH="$(date '+%s')"
    S_Q_LAST_COMPLETED_AT="$(now_iso)"
    S_Q_RUN_STARTED_AT=""
    S_Q_NEXT_EPOCH=$((QUALITY_FINISHED_EPOCH + CFG_QUALITY_INTERVAL * 60))

    if [ "$S_Q_ERRORS" -gt 0 ]; then
        S_Q_STATUS="partial"
        AUTO_CYCLE_FAILURE=1
        S_Q_LAST_ERROR="Не удалось выполнить проверку для серверов: $S_Q_ERRORS."
    else
        S_Q_STATUS="success"
        S_Q_LAST_ERROR=""
    fi

    S_Q_LAST_RESULT="Доступно: $S_Q_AVAILABLE. Недоступно: $S_Q_UNAVAILABLE. Проверено: $S_Q_CHECKED из $S_Q_TOTAL."
    save_state
    log_message "Автоматическая проверка качества завершена: $S_Q_LAST_RESULT"
}

quality_refresh_fail()
{
    QUALITY_FAILURE="$1"
    AUTO_CYCLE_FAILURE=1
    QUALITY_FINISHED_EPOCH="$(date '+%s')"
    S_Q_STATUS="error"
    S_Q_RUN_STARTED_AT=""
    S_Q_LAST_COMPLETED_AT="$(now_iso)"
    S_Q_NEXT_EPOCH=$((QUALITY_FINISHED_EPOCH + CFG_QUALITY_INTERVAL * 60))
    S_Q_LAST_RESULT="Автоматическая проверка не выполнена."
    S_Q_LAST_ERROR="$QUALITY_FAILURE"
    save_state
    log_message "Автоматическая проверка качества: $QUALITY_FAILURE"
}

run_quality_refresh()
{
    if [ "$S_Q_INTERVAL" -ne "$CFG_QUALITY_INTERVAL" ]; then
        S_Q_INTERVAL="$CFG_QUALITY_INTERVAL"
        S_Q_NEXT_EPOCH=0
    fi

    if [ "$CFG_QUALITY_ENABLED" != "true" ]; then
        S_Q_STATUS="disabled"
        S_Q_RUN_STARTED_AT=""
        S_Q_NEXT_EPOCH=0
        S_Q_LAST_ERROR=""
        save_state
        return 0
    fi

    if [ "$S_Q_NEXT_EPOCH" -gt "$NOW_EPOCH" ]; then
        if [ "$S_Q_STATUS" = "disabled" ] ||
           [ "$S_Q_STATUS" = "paused" ]
        then
            S_Q_STATUS="scheduled"
            S_Q_LAST_ERROR=""
            save_state
        fi
        return 0
    fi

    if [ -d "$UPDATE_LOCK" ]; then
        S_Q_STATUS="paused"
        S_Q_LAST_ERROR="Ожидание завершения операции Xray."
        save_state
        return 0
    fi

    QUALITY_SUMMARY="$ROOT/tmp/quality-refresh-summary.$$.json"
    QUALITY_SUMMARY_ERR="$ROOT/tmp/quality-refresh-summary.$$.err"
    QUALITY_IDS="$ROOT/tmp/quality-refresh-ids.$$.txt"
    QUALITY_OUT="$ROOT/tmp/quality-refresh-check.$$.json"
    QUALITY_ERR="$ROOT/tmp/quality-refresh-check.$$.err"

    rm -f \
        "$QUALITY_SUMMARY" "$QUALITY_SUMMARY_ERR" "$QUALITY_IDS" \
        "$QUALITY_OUT" "$QUALITY_ERR"

    S_Q_STATUS="running"
    S_Q_RUN_STARTED_AT="$(now_iso)"
    S_Q_TOTAL=0
    S_Q_CHECKED=0
    S_Q_AVAILABLE=0
    S_Q_UNAVAILABLE=0
    S_Q_ERRORS=0
    S_Q_LAST_ERROR=""
    save_state

    broray_server_summary >"$QUALITY_SUMMARY" 2>"$QUALITY_SUMMARY_ERR"
    if ! jq -e 'type == "object" and (.servers | type) == "array"' \
        "$QUALITY_SUMMARY" >/dev/null 2>&1
    then
        QUALITY_MESSAGE="$(tail -c 700 "$QUALITY_SUMMARY_ERR" 2>/dev/null)"
        [ -n "$QUALITY_MESSAGE" ] ||
            QUALITY_MESSAGE="Не удалось получить список сохранённых серверов."
        quality_refresh_fail "$QUALITY_MESSAGE"
        rm -f \
            "$QUALITY_SUMMARY" "$QUALITY_SUMMARY_ERR" "$QUALITY_IDS" \
            "$QUALITY_OUT" "$QUALITY_ERR"
        return 0
    fi

    jq -r '.servers[]? | .id // empty' "$QUALITY_SUMMARY" >"$QUALITY_IDS" || {
        quality_refresh_fail "Не удалось подготовить последовательную проверку серверов."
        rm -f \
            "$QUALITY_SUMMARY" "$QUALITY_SUMMARY_ERR" "$QUALITY_IDS" \
            "$QUALITY_OUT" "$QUALITY_ERR"
        return 0
    }

    S_Q_TOTAL="$(wc -l <"$QUALITY_IDS" 2>/dev/null | tr -d ' ')"
    case "$S_Q_TOTAL" in
        ''|*[!0-9]*) S_Q_TOTAL=0 ;;
    esac
    save_state

    while IFS= read -r QUALITY_SERVER_ID
    do
        [ -n "$QUALITY_SERVER_ID" ] || continue
        rm -f "$QUALITY_OUT" "$QUALITY_ERR"
        QUALITY_CHECK_RC=0
        broray_server_check "$QUALITY_SERVER_ID" scheduled \
            >"$QUALITY_OUT" 2>"$QUALITY_ERR" || QUALITY_CHECK_RC=$?
        case "$QUALITY_CHECK_RC" in 130|124|75|73|74) return "$QUALITY_CHECK_RC" ;; esac

        QUALITY_CHECK_STATUS="$(
            jq -r '.quality.status // empty' "$QUALITY_OUT" 2>/dev/null
        )"
        if [ "$QUALITY_CHECK_RC" -eq 0 ] &&
           [ "$QUALITY_CHECK_STATUS" = "available" ]
        then
            S_Q_AVAILABLE=$((S_Q_AVAILABLE + 1))
        elif [ "$QUALITY_CHECK_RC" -eq 1 ] &&
             [ "$QUALITY_CHECK_STATUS" = "unavailable" ]
        then
            S_Q_UNAVAILABLE=$((S_Q_UNAVAILABLE + 1))
        else
            S_Q_ERRORS=$((S_Q_ERRORS + 1))
        fi

        S_Q_CHECKED=$((S_Q_CHECKED + 1))
        save_state
    done <"$QUALITY_IDS"

    if [ ! -x "$HOME_SNAPSHOT" ] ||
       ! "${BRORAY_OPS_ASH:-/opt/bin/ash}" "$HOME_SNAPSHOT" refresh servers >>"$LOG" 2>&1
    then
        quality_refresh_fail "Проверка серверов завершена, но итоговое состояние для Главной не опубликовано."
        rm -f \
            "$QUALITY_SUMMARY" "$QUALITY_SUMMARY_ERR" "$QUALITY_IDS" \
            "$QUALITY_OUT" "$QUALITY_ERR"
        return 0
    fi

    quality_refresh_finish
    rm -f \
        "$QUALITY_SUMMARY" "$QUALITY_SUMMARY_ERR" "$QUALITY_IDS" \
        "$QUALITY_OUT" "$QUALITY_ERR"
    return 0
}

run_cycle_inner()
{
    load_config
    load_state

    S_ENABLED="$CFG_ENABLED"
    NOW_EPOCH="$(date '+%s')"

    QUALITY_CYCLE_RC=0
    run_quality_refresh || QUALITY_CYCLE_RC=$?
    [ "$QUALITY_CYCLE_RC" = 0 ] || return "$QUALITY_CYCLE_RC"
    NOW_EPOCH="$(date '+%s')"

    if [ "$CFG_ENABLED" != "true" ]; then
        S_STATUS="disabled"
        S_FAILURES=0
        S_CANDIDATE_COUNT=0
        S_LAST_REASON="Автовыбор выключен"
        S_LAST_ERROR=""
        save_state
        return 0
    fi

    if [ -d "$UPDATE_LOCK" ]; then
        S_STATUS="paused"
        S_LAST_REASON="Ожидание завершения операции Xray"
        S_LAST_ERROR=""
        save_state
        return 0
    fi

    SUMMARY_FILE="$ROOT/tmp/auto-switch-summary.$$.json"
    SUMMARY_ERR="$ROOT/tmp/auto-switch-summary.$$.err"
    ACTIVE_ID="$(sed -n '1p' "$ACTIVE_SERVER_FILE" 2>/dev/null || true)"
    XRAY_RUNNING=false
    pidof xray >/dev/null 2>&1 && XRAY_RUNNING=true

    if [ "$S_ACTIVE_ID" != "$ACTIVE_ID" ]; then
        S_FAILURES=0
        S_MONITOR_FINGERPRINT=""
    fi

    S_ACTIVE_ID="$ACTIVE_ID"

    if [ -z "$ACTIVE_ID" ]; then
        S_STATUS="manual-off"
        S_FAILURES=0
        S_CANDIDATE_COUNT=0
        S_LAST_REASON="VPN отключён вручную"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    if [ "$XRAY_RUNNING" != "true" ]; then
        S_STATUS="paused"
        S_FAILURES=0
        S_CANDIDATE_COUNT=0
        S_LAST_REASON="Xray остановлен; автоматический запуск запрещён"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    monitor_state

    if [ "$MONITOR_HEALTH" = "unknown" ]; then
        S_STATUS="paused"
        S_LAST_REASON="Монитор соединения не подтвердил состояние"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    if [ "$MONITOR_HEALTH" = "true" ]; then
        S_STATUS="healthy"
        S_FAILURES=0
        S_MONITOR_FINGERPRINT=""
        S_CANDIDATE_COUNT=0
        S_LAST_REASON="Активное соединение работает"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    if [ -n "$MONITOR_FINGERPRINT" ] &&
       [ "$MONITOR_FINGERPRINT" != "$S_MONITOR_FINGERPRINT" ]
    then
        S_FAILURES=$((S_FAILURES + 1))
        S_MONITOR_FINGERPRINT="$MONITOR_FINGERPRINT"
    fi

    if [ "$S_FAILURES" -lt "$CFG_THRESHOLD" ]; then
        S_STATUS="waiting-threshold"
        S_LAST_REASON="Ожидание порога ошибок: $S_FAILURES из $CFG_THRESHOLD"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    SINCE_ATTEMPT=$((NOW_EPOCH - S_LAST_ATTEMPT_EPOCH))

    if [ "$S_LAST_ATTEMPT_EPOCH" -gt 0 ] &&
       [ "$SINCE_ATTEMPT" -lt "$ATTEMPT_GUARD_SECONDS" ]
    then
        S_STATUS="attempt-guard"
        S_LAST_REASON="Ожидание перед повторной проверкой кандидатов"
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    COOLDOWN_SECONDS=$((CFG_COOLDOWN * 60))
    SINCE_SWITCH=$((NOW_EPOCH - S_LAST_SWITCH_EPOCH))

    if [ "$S_LAST_SWITCH_EPOCH" -gt 0 ] &&
       [ "$SINCE_SWITCH" -lt "$COOLDOWN_SECONDS" ]
    then
        S_STATUS="cooldown"
        S_LAST_REASON="Защита от частых переключений"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
    broray_server_summary > "$SUMMARY_FILE" 2> "$SUMMARY_ERR"

    if ! jq -e 'type == "object"' "$SUMMARY_FILE" >/dev/null 2>&1; then
        S_STATUS="error"
        S_LAST_REASON="Не удалось получить состояние серверов"
        S_LAST_ERROR="$(tail -c 700 "$SUMMARY_ERR" 2>/dev/null)"
        [ -n "$S_LAST_ERROR" ] || S_LAST_ERROR="Summary не вернул корректный JSON."
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 1
    fi

    SUMMARY_ACTIVE_ID="$(jq -r '.activeServer.id // empty' "$SUMMARY_FILE")"
    SUMMARY_XRAY_RUNNING="$(jq -r '.xrayRunning // false' "$SUMMARY_FILE")"

    if [ "$SUMMARY_ACTIVE_ID" != "$ACTIVE_ID" ]; then
        S_STATUS="cancelled"
        S_FAILURES=0
        S_ACTIVE_ID="$SUMMARY_ACTIVE_ID"
        S_LAST_REASON="Активный сервер изменён во время проверки"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    if [ "$SUMMARY_XRAY_RUNNING" != "true" ]; then
        S_STATUS="paused"
        S_FAILURES=0
        S_CANDIDATE_COUNT=0
        S_LAST_REASON="Xray остановлен; автоматический запуск запрещён"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR"
        return 0
    fi

    S_STATUS="checking-candidates"
    S_LAST_ATTEMPT_EPOCH="$NOW_EPOCH"
    S_LAST_ATTEMPT_AT="$(now_iso)"
    S_LAST_REASON="Реальная проверка резервных серверов"
    S_LAST_ERROR=""
    save_state

    CANDIDATE_FILE="$ROOT/tmp/auto-switch-candidates.$$.json"

    build_candidates "$SUMMARY_FILE" "$ACTIVE_ID" "$CANDIDATE_FILE"
    BUILD_RC="$?"
    case "$BUILD_RC" in 130|124|75|73|74) return "$BUILD_RC" ;; esac

    S_CANDIDATE_COUNT="$(jq 'length' "$CANDIDATE_FILE" 2>/dev/null)"
    case "$S_CANDIDATE_COUNT" in
        ''|*[!0-9]*) S_CANDIDATE_COUNT=0 ;;
    esac

    if [ "$BUILD_RC" -ne 0 ] ||
       [ "$S_CANDIDATE_COUNT" -eq 0 ]
    then
        S_STATUS="no-candidate"
        S_LAST_REASON="Подходящий сервер не найден"
        S_LAST_ERROR="Нет сервера с подтверждённым HTTPS-трафиком и требуемым качеством."
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
        log_message "$S_LAST_ERROR"
        return 1
    fi

    if ! select_candidate "$CANDIDATE_FILE"; then
        S_STATUS="no-candidate"
        S_LAST_REASON="Правило выбора не определило сервер"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
        return 0
    fi

    SELECTED_ID="$(printf '%s\n' "$SELECTED_JSON" | jq -r '.id // empty')"
    SELECTED_NAME="$(printf '%s\n' "$SELECTED_JSON" | jq -r '.name // .id // empty')"

    load_config

    if [ "$CFG_ENABLED" != "true" ]; then
        S_ENABLED=false
        S_STATUS="disabled"
        S_LAST_REASON="Автовыбор выключен во время проверки"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
        return 0
    fi

    monitor_state

    if [ "$MONITOR_HEALTH" = "true" ]; then
        S_STATUS="recovered"
        S_FAILURES=0
        S_LAST_REASON="Соединение восстановилось до переключения"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
        return 0
    fi

    FRESH_SUMMARY="$ROOT/tmp/auto-switch-fresh.$$.json"
    broray_server_summary > "$FRESH_SUMMARY" 2>/dev/null
    FRESH_ACTIVE="$(jq -r '.activeServer.id // empty' "$FRESH_SUMMARY" 2>/dev/null)"

    if [ "$FRESH_ACTIVE" != "$ACTIVE_ID" ]; then
        S_STATUS="cancelled"
        S_FAILURES=0
        S_ACTIVE_ID="$FRESH_ACTIVE"
        S_LAST_REASON="Активный сервер изменён вручную"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE" "$FRESH_SUMMARY"
        return 0
    fi

    rm -f "$FRESH_SUMMARY"

    if [ "$DRY_RUN" = "true" ]; then
        S_STATUS="dry-run"
        S_LAST_REASON="Dry-run: выбран кандидат $SELECTED_NAME"
        S_LAST_ERROR=""
        save_state
        rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
        log_message "Dry-run: $ACTIVE_ID -> $SELECTED_ID ($SELECTED_NAME)"
        return 0
    fi

    S_STATUS="switching"
    S_LAST_REASON="Переключение на $SELECTED_NAME"
    S_LAST_ERROR=""
    save_state

    if activate_candidate "$ACTIVE_ID" "$SELECTED_ID" "$SELECTED_NAME"; then
        S_STATUS="switched"
        S_ACTIVE_ID="$SELECTED_ID"
        S_FAILURES=0
        S_LAST_SWITCH_EPOCH="$(date '+%s')"
        S_LAST_SWITCH_AT="$(now_iso)"
        S_LAST_SWITCH_FROM="$ACTIVE_ID"
        S_LAST_SWITCH_TO="$SELECTED_ID"
        S_LAST_SWITCH_NAME="$SELECTED_NAME"
        S_LAST_REASON="Автоматически выбран сервер: $SELECTED_NAME"
        S_LAST_ERROR=""
        save_state
        log_message "Переключение $ACTIVE_ID -> $SELECTED_ID ($SELECTED_NAME)"
    else
        S_STATUS="error"
        AUTO_CYCLE_FAILURE=1
        S_LAST_REASON="Ошибка переключения"
        save_state
        log_message "$S_LAST_REASON: $S_LAST_ERROR"
    fi

    rm -f "$SUMMARY_FILE" "$SUMMARY_ERR" "$CANDIDATE_FILE"
    return 0
}

run_cycle()
{
    load_config
    if [ "$CFG_ENABLED" != true ] && [ "$CFG_QUALITY_ENABLED" != true ] &&
      jq -e '.status=="disabled" and .qualityRefresh.status=="disabled"' "$STATE" >/dev/null 2>&1; then return 0; fi
    if [ "$CFG_ENABLED" != true ] && [ "$CFG_QUALITY_ENABLED" = true ] &&
      jq -e --argjson now "$(date '+%s')" --argjson interval "$CFG_QUALITY_INTERVAL" \
        '.qualityRefresh.intervalMinutes==$interval and .qualityRefresh.nextCheckEpoch>$now and
         (.qualityRefresh.status=="success" or .qualityRefresh.status=="scheduled" or .qualityRefresh.status=="partial" or .qualityRefresh.status=="error")' "$STATE" >/dev/null 2>&1; then return 0; fi
    if [ "$DRY_RUN" = true ]; then job_mode=--job-dry-run; else job_mode=--job; fi
    "${BRORAY_OPS_ASH:-/opt/bin/ash}" "$ROOT/bin/broray-server-auto-switch" "$job_mode"
}

if [ "$MODE" = job ]; then
    # Preserve any old cycle lock for compatibility recovery.
    [ ! -e "$LOCK" ] && [ ! -L "$LOCK" ] || exit 2
    load_config
    job_source=AUTO_SWITCH
    [ "$CFG_ENABLED" = true ] || job_source=SERVER_CHECK_AUTO
    job_rc=0
    broray_job_begin system auto-switch servers "$job_source" cooperative || job_rc=$?
    [ "$job_rc" != 2 ] || exit 0
    [ "$job_rc" = 0 ] || exit "$job_rc"
    job_exit() {
        local final_rc
        final_rc="$1"; trap - EXIT
        broray_job_exit "$final_rc" || final_rc=75
        exit "$final_rc"
    }
    trap 'job_exit "$?"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    AUTO_CYCLE_FAILURE=0
    run_cycle_inner || exit $?
    exit "$AUTO_CYCLE_FAILURE"
fi

trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if [ "$MODE" = once ]; then run_cycle; exit $?; fi
log_message "Сервис автоматического выбора запущен"
while :; do
    run_cycle || log_message "Цикл завершился ошибкой"
    sleep "$INTERVAL_SECONDS"
done
