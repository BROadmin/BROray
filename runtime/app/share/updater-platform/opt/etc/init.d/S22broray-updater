#!/opt/bin/ash
# Retained coordinator revision: integer-only protected stop polling (20260924).
set -u

updater_stat()
(
    # Entware may omit standalone stat and BusyBox FEATURE_STAT_FORMAT.
    # An installed stat's failure remains authoritative; never mask it.
    if command -v stat >/dev/null 2>&1; then
        stat "$@"
        exit $?
    fi
    follow=''
    if [ "${1:-}" = -L ]; then follow=-L; shift; fi
    [ "$#" -ge 3 ] && [ "$1" = -c ] || exit 75
    format="$2"; shift 2
    case "$format" in '%a'|'%a:%u'|'%u:%a:%h') ;; *) exit 75 ;; esac
    for path in "$@"
    do
        if [ -n "$follow" ]; then
            row="$(busybox stat -L -t "$path")" || exit 75
        else
            row="$(busybox stat -t "$path")" || exit 75
        fi
        # Strip the exact filename first so embedded spaces do not shift fields.
        case "$row" in "$path "*) fields="${row#"$path "}" ;; *) exit 75 ;; esac
        set -f
        set -- $fields
        [ "$#" -eq 14 ] || exit 75
        raw_mode="$3"; owner="$4"; links="$8"
        case "$raw_mode" in ''|*[!0-9a-fA-F]*) exit 75 ;; esac
        [ "${#raw_mode}" -le 8 ] || exit 75
        case "$owner" in ''|*[!0-9]*) exit 75 ;; esac
        case "$links" in ''|*[!0-9]*) exit 75 ;; esac
        mode="$((0x$raw_mode & 07777))"
        case "$format" in
            '%a') printf '%o\n' "$mode" ;;
            '%a:%u') printf '%o:%s\n' "$mode" "$owner" ;;
            '%u:%a:%h') printf '%s:%o:%s\n' "$owner" "$mode" "$links" ;;
        esac
    done
)

# Installed entry uses retained authenticated code; neither PID nor init
# status may stand in for an exact live generation. No legacy launch fallback.
fail()
{
    printf '{"ok":false,"errorCode":"%s","platformReady":false}\n' "$1"
    exit 75
}

# Discovery only: the retained native entry still proves generation/readiness.
# Completed migrations for older platform bytes remain immutable history and
# must not make the currently installed origin ambiguous. Never select by age.
installed_platform_manifest()
(
    rows=''
    for relative in opt/bin/broray-updaterctl \
        opt/etc/init.d/S22broray-updater \
        opt/libexec/broray-updater/broray-compat.sh \
        opt/libexec/broray-updater/broray-migrate-legacy.sh \
        opt/libexec/broray-updater/broray-updater.sh \
        opt/libexec/broray-updater/minisign \
        opt/libexec/broray-updater/xray-wrapper
    do
        path="$prefix/$relative"
        [ -f "$path" ] && [ ! -L "$path" ] || exit 75
        metadata="$(updater_stat -c '%u:%a:%h' "$path")" || exit 75
        [ "$metadata" = "$(id -u):755:1" ] || exit 75
        digest="$(sha256sum "$path")" || exit 75
        digest="${digest%% *}"
        rows="${rows}${digest}  ${relative}
"
    done
    result="$(printf '%s' "$rows" | sha256sum)" || exit 75
    printf '%s\n' "${result%% *}"
)
# Discovery follows replacement ancestry, never timestamp or PID. The selected
# leaf still has to pass its retained native completion/readiness proof below.
# This distinguishes native-only upgrades whose seven platform files coincide.
origin_superseded()
(
    wanted="$1"
    for successor in "$state/operations"/op-*/state.json; do
        [ -f "$successor" ] && [ ! -L "$successor" ] || exit 75
        jq -e '.operation=="system:platform-preflight" and .state=="completed" and
          .running==false and (has("serviceStop")|not) and
          .platformPreflight.generationStop!=null' "$successor" >/dev/null || continue
        generation="$(jq -er '.platformPreflight.generationStop|select(.contract=="broray-platform-generation-stop/1")|
          .generationId|select(type=="string" and length==24 and startswith("g-") and
            all(explode[]; (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122) or .==95 or .==45))' "$successor")" || exit 75
        anchor="$prefix/opt/var/lib/broray-updater/generations/$generation/state.json"
        [ -f "$anchor" ] && [ ! -L "$anchor" ] || exit 75
        jq -e --slurpfile original "$anchor" '.platformPreflight.generationStop as $old |
          ($original|length)==1 and $original[0].generationId==$old.generationId and
          $original[0].platformManifestSha256==$old.platformManifestSha256 and
          $original[0].platformLaunch.nativeSha256==$old.nativeSha256' "$successor" >/dev/null || exit 75
        if jq -e --arg id "$wanted" '.platformLaunch.operationId==$id' "$anchor" >/dev/null; then
            [ "$successor" != "$state/operations/$wanted/state.json" ] || exit 75
            exit 0
        fi
    done
    exit 1
)

case "${1:-}" in
    start) step=recovery-resume ;;
    status) step=recovery-status ;;
    stop) step=service-cycle-stop ;;
    restart) step=service-cycle-restart ;;
    *) printf '%s\n' 'Использование: S22broray-updater {start|stop|restart|status}' >&2; exit 2 ;;
esac

prefix="${BRORAY_UPDATER_ROOT_PREFIX:-}"
[ "$prefix" != / ] || prefix=''
case "$prefix" in ''|/*) ;; *) fail UPDATER_SERVICE_ROOT_INVALID ;; esac
PATH="$prefix/opt/bin:$prefix/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
LC_ALL=C
export PATH LC_ALL
state="$prefix/opt/var/lib/broray"
lock="$prefix/opt/var/lock/broray/global-operation.lock"
operation=''
if [ -L "$lock" ]; then
    target="$(readlink "$lock")" || fail UPDATER_SERVICE_FENCE_UNCONFIRMED
    case "$target" in
        "$state/operations/"op-*/fence) operation="${target%/fence}"; operation="${operation##*/}" ;;
        *) fail UPDATER_SERVICE_FENCE_UNCONFIRMED ;;
    esac
elif [ -e "$lock" ]; then
    fail UPDATER_SERVICE_FENCE_UNCONFIRMED
else
    installed_manifest="$(installed_platform_manifest)" || fail UPDATER_SERVICE_PLATFORM_UNCONFIRMED
    for file in "$state/operations"/op-*/state.json; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        [ -f "$file" ] && [ ! -L "$file" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
        jq -e . "$file" >/dev/null 2>&1 || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
        jq -e '.operation=="system:platform-preflight" and .state=="completed" and .running==false' "$file" >/dev/null || continue
        # A completed service stop refers to its retained launch origin; it
        # is not another installed runtime. The guarded entry verifies its
        # full binding and terminal proof before returning a repeated reply.
        if jq -e 'has("serviceStop")' "$file" >/dev/null; then
            jq -e '((.serviceStop.schemaVersion==1 and .serviceStop.contract=="broray-service-stop/1") or
              (.serviceStop.schemaVersion==2 and .serviceStop.contract=="broray-service-stop/2" and .serviceStop.originKind=="supervised-replacement")) and
              (.serviceStop.originOperationId|type=="string" and (length>3 and startswith("op-") and (.[3:]|all(explode[]; (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122) or .==95 or .==45))))' "$file" >/dev/null || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
            continue
        fi
        jq -e --arg manifest "$installed_manifest" \
          '.platformPreflight.expectedPlatformManifestSha256==$manifest' "$file" >/dev/null || continue
        candidate="${file%/state.json}"; candidate="${candidate##*/}"
        superseded=0
        origin_superseded "$candidate" || superseded=$?
        case "$superseded" in 0) continue ;; 1) ;; *) fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED ;; esac
        [ -z "$operation" ] || fail UPDATER_SERVICE_IDENTITY_AMBIGUOUS
        operation="$candidate"
    done
fi
case "$operation" in op-*) ;; *) fail UPDATER_SERVICE_IDENTITY_UNCONFIRMED ;; esac
case "$operation" in *[!A-Za-z0-9_-]*) fail UPDATER_SERVICE_IDENTITY_UNCONFIRMED ;; esac
[ "${#operation}" -le 96 ] || fail UPDATER_SERVICE_IDENTITY_UNCONFIRMED
if [ "$step" = service-cycle-stop ] || [ "$step" = service-cycle-restart ]; then
    owner_state="$state/operations/$operation/state.json"
    [ -f "$owner_state" ] && [ ! -L "$owner_state" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    if jq -e 'has("serviceStop")' "$owner_state" >/dev/null; then
        origin="$(jq -er '.serviceStop|select((.schemaVersion==1 and .contract=="broray-service-stop/1") or
          (.schemaVersion==2 and .contract=="broray-service-stop/2" and .originKind=="supervised-replacement"))|
          .originOperationId|select(type=="string" and (length>3 and startswith("op-") and (.[3:]|all(explode[]; (.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122) or .==95 or .==45))) and length<=96)' "$owner_state")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
        [ "$origin" != "$operation" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
        operation="$origin"
    fi
fi
replacement="$state/operations/$operation/platform-replacement-service.json"
replacement_anchor="$state/operations/$operation/platform-replacement-service.anchor"
if [ -e "$replacement" ] || [ -L "$replacement" ] || [ -e "$replacement_anchor" ] || [ -L "$replacement_anchor" ]; then
    for file in "$replacement" "$replacement_anchor"; do
        [ -f "$file" ] && [ ! -L "$file" ] &&
          [ "$(updater_stat -c '%u:%a:%h' "$file")" = "$(id -u):600:1" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    done
    jq -e --arg id "$operation" '
      .schemaVersion==1 and .contract=="broray-replacement-service/1" and .operationId==$id and
      ([.nativeSha256,.startIntentSha256,.platformManifestSha256,.codeManifestSha256]|all(.[];
        type=="string" and length==64 and all(explode[]; (.>=48 and .<=57) or (.>=97 and .<=102)))) and
      (.stopNonce|type=="string" and length==32 and all(explode[]; (.>=48 and .<=57) or (.>=97 and .<=102)))' "$replacement" >/dev/null || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    replacement_sha="$(sha256sum "$replacement")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    expected_anchor="$(printf 'BROray-replacement-service-anchor/1\n%s\n' "${replacement_sha%% *}" | sha256sum)" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    actual_anchor="$(sha256sum "$replacement_anchor")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    [ "${actual_anchor%% *}" = "${expected_anchor%% *}" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    native_sha="$(jq -er .nativeSha256 "$replacement")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    migration="$(jq -er .startIntentSha256 "$replacement")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    nonce="$(jq -er .stopNonce "$replacement")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
    native="$prefix/opt/var/lib/broray-updater/runtimes/$native_sha/runtime"
    step="replacement-service-$1"
else
binding="$state/operations/$operation/platform-bootguard.json"
[ -f "$binding" ] && [ ! -L "$binding" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
jq -e --arg id "$operation" '
  .schemaVersion==1 and .contract=="broray-platform-bootguard/1" and .operationId==$id and
  (.nativeSha256|type=="string" and (type=="string" and length==64 and all(explode[]; (.>=48 and .<=57) or (.>=97 and .<=102)))) and
  (.migrationIntentSha256|type=="string" and (type=="string" and length==64 and all(explode[]; (.>=48 and .<=57) or (.>=97 and .<=102)))) and
  (.stopNonce|type=="string" and (type=="string" and length==32 and all(explode[]; (.>=48 and .<=57) or (.>=97 and .<=102))))' "$binding" >/dev/null || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
native_sha="$(jq -er .nativeSha256 "$binding")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
migration="$(jq -er .migrationIntentSha256 "$binding")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
nonce="$(jq -er .stopNonce "$binding")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
# Discovery fields do not choose executable code. Cross-check their exact
# binding against the independently retained closure before opening runtime.
recovery_binding="$state/operations/$operation/platform-recovery-code.json"
[ -f "$recovery_binding" ] && [ ! -L "$recovery_binding" ] || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
guard_sha="$(sha256sum "$binding")" || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
guard_sha="${guard_sha%% *}"
jq -e --arg id "$operation" --arg native "$native_sha" --arg migration "$migration" \
  --arg nonce "$nonce" --arg guard "$guard_sha" '
  .schemaVersion==1 and .contract=="broray-recovery-code/1" and .operationId==$id and
  .nativeSha256==$native and .migrationIntentSha256==$migration and .stopNonce==$nonce and
  .bootGuardBindingSha256==$guard' "$recovery_binding" >/dev/null || fail UPDATER_SERVICE_EVIDENCE_UNCONFIRMED
native="$state/operations/$operation/platform-bootguard/runtime"
fi
[ -f "$native" ] && [ ! -L "$native" ] && [ -x "$native" ] || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
exec 8<"$native" || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
identity="$(updater_stat -L -c '%u:%a:%h' /proc/self/fd/8)" || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
[ "$identity" = "$(id -u):700:1" ] || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
actual="$(sha256sum <&8)" || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
[ "${actual%% *}" = "$native_sha" ] || fail UPDATER_SERVICE_RUNTIME_UNCONFIRMED
# Execute the same opened native inode that was hashed, not a fresh path lookup.
exec /proc/self/fd/8 "$step" "${prefix:-/}" "$operation" "$migration" "$nonce"
