{
  "schemaVersion": 1,
  "id": "wikipedia",
  "name": "Wikipedia",
  "source": {
    "provider": "github",
    "repository": "RockBlack-VPN/ip-address",
    "branch": "main",
    "directory": "Global/wikipedia",
    "files": [
      {
        "name": "wikipedia.bat",
        "type": "windows-route-bat",
        "enabled": true
      }
    ],
    "discovery": {
      "mode": "all-bat",
      "recursive": false
    }
  },
  "targetInterface": "Proxy0",
  "exportComment": "BROray",
  "limits": {
    "maxSourceBytes": 65536,
    "maxRoutes": 256
  }
}
