#!/opt/bin/ash
ENABLED=yes
ROOT="${BRORAY_ROOT:-/opt/broray}"
ASH="${BRORAY_OPS_ASH:-/opt/bin/ash}"
case "${1:-}" in
    start|stop|restart|status)
        exec "$ASH" "$ROOT/bin/broray-service" auto-switch "$1" ;;
    run-once) exec "$ASH" "$ROOT/bin/broray-server-auto-switch" --once ;;
    dry-run) exec "$ASH" "$ROOT/bin/broray-server-auto-switch" --dry-run ;;
    *) exit 64 ;;
esac
