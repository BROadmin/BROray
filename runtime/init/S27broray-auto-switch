#!/opt/bin/ash

ENABLED=yes
DESC="BROray Server Auto Switch"

ROOT="/opt/broray"
DAEMON="$ROOT/bin/broray-server-auto-switch"
PIDFILE="$ROOT/run/server-auto-switch.pid"
LOG="$ROOT/logs/server-auto-switch.log"

start()
{
    mkdir -p "$ROOT/run" "$ROOT/logs"

    if [ -f "$PIDFILE" ]; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"

        if [ -n "$PID" ] &&
           kill -0 "$PID" 2>/dev/null
        then
            echo "Автовыбор уже работает, PID $PID"
            return 0
        fi

        rm -f "$PIDFILE"
    fi

    [ -x "$DAEMON" ] || {
        echo "Не найден $DAEMON"
        return 1
    }

    start-stop-daemon \
        -S \
        -b \
        -m \
        -p "$PIDFILE" \
        -x /opt/bin/ash \
        -- "$DAEMON" ||
        return 1

    sleep 1

    PID="$(cat "$PIDFILE" 2>/dev/null)"

    if [ -z "$PID" ] ||
       ! kill -0 "$PID" 2>/dev/null
    then
        echo "Ошибка запуска автовыбора"
        tail -n 40 "$LOG" 2>/dev/null
        return 1
    fi

    echo "Автовыбор запущен, PID $PID"
}

stop()
{
    if [ ! -f "$PIDFILE" ]; then
        echo "Автовыбор не запущен"
        return 0
    fi

    PID="$(cat "$PIDFILE" 2>/dev/null)"

    if [ -n "$PID" ]; then
        kill "$PID" 2>/dev/null || true

        ATTEMPT=0
        while kill -0 "$PID" 2>/dev/null
        do
            ATTEMPT=$((ATTEMPT + 1))
            [ "$ATTEMPT" -lt 8 ] || break
            sleep 1
        done

        if kill -0 "$PID" 2>/dev/null; then
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi

    rm -f "$PIDFILE"
    echo "Автовыбор остановлен"
}

restart()
{
    stop
    start
}

status()
{
    if [ -f "$PIDFILE" ]; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"

        if [ -n "$PID" ] &&
           kill -0 "$PID" 2>/dev/null
        then
            echo "Автовыбор работает"
            echo "PID: $PID"
            return 0
        fi
    fi

    echo "Автовыбор не запущен"
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    run-once) /opt/bin/ash "$DAEMON" --once ;;
    dry-run) /opt/bin/ash "$DAEMON" --dry-run ;;

    *)
        echo "Использование: $0 {start|stop|restart|status|run-once|dry-run}"
        exit 1
        ;;
esac
