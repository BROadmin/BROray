#!/opt/bin/ash

ENABLED=yes
# This service intentionally does not set PROCS=lighttpd. Entware's generic
# S80lighttpd uses basename-wide pidof/killall; BROray runs a private renamed
# executable and owns only the exact exe+argv identity recorded by its PID file.
DESC="BROray WebUI"

BASE="${BRORAY_WEB_BASE:-/opt/broray}"
CONF="${BRORAY_WEB_CONF:-$BASE/config/lighttpd.conf}"
PIDFILE="${BRORAY_WEB_PIDFILE:-$BASE/run/lighttpd.pid}"
LOG="${BRORAY_WEB_LOG:-$BASE/logs/lighttpd-error.log}"
NETWORK="${BRORAY_WEB_NETWORK:-$BASE/lib/network.sh}"
SOURCE_BINARY="${BRORAY_WEB_SOURCE_BINARY:-/opt/sbin/lighttpd}"
RUNTIME_BINARY="${BRORAY_WEB_RUNTIME_BINARY:-$BASE/runtime/broray-lighttpd}"
PROC_ROOT="${BRORAY_WEB_PROC_ROOT:-/proc}"
CURL_BINARY="${BRORAY_WEB_CURL_BINARY:-/opt/bin/curl}"
NATIVE_AUTH_LIBRARY="${BRORAY_WEB_NATIVE_AUTH_LIBRARY:-$BASE/lib/web-auth-native.sh}"

broray_web_pid_read()
{
    [ -f "$PIDFILE" ] && [ ! -L "$PIDFILE" ] || return 1
    awk '
        NR == 1 && $0 ~ /^[0-9]+$/ && $0 > 1 {pid = $0; next}
        {bad = 1}
        END {
            if (!bad && pid != "") print pid
            else exit 1
        }
    ' "$PIDFILE"
}

broray_web_lan_ip()
{
    local value

    value="$(sed -n '1p' "$BASE/run/lan-ip" 2>/dev/null || true)"
    printf '%s\n' "$value" | awk -F. '
        NF != 4 {exit 1}
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
            }
        }
    ' || return 1
    printf '%s\n' "$value"
}

broray_web_process_signature_once()
{
    local pid proc executable expected rc

    pid="$1"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] || return 1
    proc="$PROC_ROOT/$pid"
    [ -r "$proc/cmdline" ] || return 1

    executable="$(readlink "$proc/exe" 2>/dev/null || true)"
    [ "$executable" = "$RUNTIME_BINARY" ] || return 1

    # Never put /proc/PID/cmdline in a shell variable: NUL is the only safe
    # argv boundary. Compare its bytes with an exact NUL-delimited allowlist.
    expected="$BASE/run/.lighttpd-argv.$$.${pid}"
    umask 077
    printf '%s\000%s\000%s\000' \
        "$RUNTIME_BINARY" '-f' "$CONF" >"$expected" || return 1
    cmp -s "$proc/cmdline" "$expected"
    rc=$?
    rm -f "$expected"
    return "$rc"
}

broray_web_process_identity_once()
{
    local pid

    pid="$1"
    kill -0 "$pid" 2>/dev/null || return 1
    broray_web_process_signature_once "$pid" || return 1
    kill -0 "$pid" 2>/dev/null
}

broray_web_process_identity_twice()
{
    local pid

    pid="$1"
    broray_web_process_identity_once "$pid" || return 1
    broray_web_process_identity_once "$pid"
}

broray_web_http_healthy()
{
    local lan code

    lan="$(broray_web_lan_ip)" || return 1
    [ -x "$CURL_BINARY" ] || return 1
    code="$(
        unset http_proxy https_proxy all_proxy \
            HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY no_proxy
        "$CURL_BINARY" -q -sS --noproxy '*' --max-time 30 \
            -o /dev/null -w '%{http_code}' "http://$lan:8080/"
    )" || return 1
    [ "$code" = 200 ]
}

broray_web_prepare_runtime_binary()
{
    local temporary

    [ -f "$SOURCE_BINARY" ] && [ ! -L "$SOURCE_BINARY" ] &&
    [ -x "$SOURCE_BINARY" ] || {
        echo "Некорректный lighttpd: $SOURCE_BINARY" >&2
        return 1
    }
    mkdir -p "${RUNTIME_BINARY%/*}" || return 1

    if [ -e "$RUNTIME_BINARY" ] || [ -L "$RUNTIME_BINARY" ]; then
        [ -f "$RUNTIME_BINARY" ] && [ ! -L "$RUNTIME_BINARY" ] || {
            echo "Небезопасный runtime lighttpd: $RUNTIME_BINARY" >&2
            return 1
        }
        if [ -x "$RUNTIME_BINARY" ] && cmp -s "$SOURCE_BINARY" "$RUNTIME_BINARY"; then
            return 0
        fi
    fi

    temporary="$RUNTIME_BINARY.new.$$"
    cp "$SOURCE_BINARY" "$temporary" || {
        rm -f "$temporary"
        return 1
    }
    chmod 0755 "$temporary" || {
        rm -f "$temporary"
        return 1
    }
    cmp -s "$SOURCE_BINARY" "$temporary" || {
        rm -f "$temporary"
        return 1
    }
    mv -f "$temporary" "$RUNTIME_BINARY"
}

broray_web_configure_bind()
{
    local lan temporary binds ports
    lan="$1"
    broray_network_ipv4_valid "$lan" || return 1
    [ -f "$CONF" ] && [ ! -L "$CONF" ] || return 1
    binds="$(awk '/^server\.bind[[:space:]]*=/{n++} END{print n+0}' "$CONF")"
    ports="$(awk '/^server\.port[[:space:]]*=/{n++} END{print n+0}' "$CONF")"
    [ "$binds" -le 1 ] && [ "$ports" = 1 ] || return 1
    temporary="$(mktemp "${CONF%/*}/.lighttpd-bind.XXXXXXXXXX")" || return 1
    if ! awk -v lan="$lan" -v binds="$binds" '
      /^server\.bind[[:space:]]*=/ {print "server.bind = \"" lan "\"";next}
      /^server\.port[[:space:]]*=/ {if(binds==0)print "server.bind = \"" lan "\""}
      {print}' "$CONF" >"$temporary";then rm -f "$temporary";return 1;fi
    if ! "$RUNTIME_BINARY" -tt -f "$temporary";then rm -f "$temporary";return 1;fi
    if cmp -s "$temporary" "$CONF";then rm -f "$temporary";return 0;fi
    chmod 600 "$temporary" && mv -f "$temporary" "$CONF" || { rm -f "$temporary";return 1; }
}

broray_web_config_valid()
{
    [ -f "$CONF" ] && [ ! -L "$CONF" ] && [ -s "$CONF" ] &&
        "$RUNTIME_BINARY" -tt -f "$CONF" >/dev/null 2>&1
}

broray_web_recovery_stat()
{
    [ -f "$BASE/lib/operation-owner.sh" ] && [ ! -L "$BASE/lib/operation-owner.sh" ] || return 1
    . "$BASE/lib/operation-owner.sh" || return 1
    broray_ops_file_stat -c '%u %a %h %s' "$1"
}

broray_web_evidence()
{
    local target reason directory count metadata size hash
    target="$1"; reason="$2"
    case "$target" in "$BASE/config/lighttpd.conf"|"$BASE/run/lighttpd.pid") ;; *) return 1 ;; esac
    [ ! -L "$BASE/logs" ] && [ ! -L "$BASE/logs/webui-recovery" ] || return 1
    directory="$BASE/logs/webui-recovery"
    mkdir -p "$directory" && chmod 700 "$directory" || return 1
    # Eight incidents, each at most 64 KiB. Keep evidence rather than silently
    # deleting the oldest incident; a full evidence budget refuses recovery.
    count="$(find "$directory" -mindepth 1 -maxdepth 1 -type d | wc -l)" || return 1
    [ "$count" -lt 8 ] || return 1
    BRORAY_WEB_EVIDENCE="$(mktemp -d "$directory/incident.XXXXXXXX")" || return 1
    if [ -e "$target" ] || [ -L "$target" ]; then
        [ -f "$target" ] && [ ! -L "$target" ] || return 1
        metadata="$(broray_web_recovery_stat "$target")" || return 1
        set -- $metadata
        [ "$#" = 4 ] && [ "$1" = "$(id -u)" ] && [ "$3" = 1 ] && [ "$4" -le 65536 ] || return 1
        hash="$(sha256sum "$target" | awk '{print $1}')" || return 1
        cp -p "$target" "$BRORAY_WEB_EVIDENCE/before" && chmod 600 "$BRORAY_WEB_EVIDENCE/before" || return 1
        cmp -s "$target" "$BRORAY_WEB_EVIDENCE/before" || return 1
        [ "$hash" = "$(sha256sum "$BRORAY_WEB_EVIDENCE/before" | awk '{print $1}')" ] || return 1
    else
        metadata=absent; hash=absent
    fi
    {
        printf 'reason=%s\ntarget=%s\nmetadata_uid_mode_links_bytes=%s\nsha256=%s\n' "$reason" "$target" "$metadata" "$hash"
        printf 'observedAt=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'bootId='; head -c 128 "$PROC_ROOT/sys/kernel/random/boot_id" 2>/dev/null; printf '\n'
        printf 'uptime='; head -c 128 "$PROC_ROOT/uptime" 2>/dev/null; printf '\n'
        [ ! -e "$target" ] || ls -ldn "$target"
    } >"$BRORAY_WEB_EVIDENCE/receipt" || return 1
    sync || return 1
}

broray_web_no_private_process()
{
    local process executable
    for process in "$PROC_ROOT"/[0-9]*; do
        [ -d "$process" ] || continue
        executable="$(readlink "$process/exe" 2>/dev/null || true)"
        # An orphan or an unexpected argv of our private binary is ambiguous;
        # never start a second daemon or signal it based on a filename.
        [ "$executable" != "$RUNTIME_BINARY" ] || return 1
    done
}

broray_web_retire_invalid_pid()
(
    local pid
    [ -f "$PIDFILE" ] && [ ! -L "$PIDFILE" ] || exit 1
    pid="$(broray_web_pid_read 2>/dev/null || true)"
    if [ -n "$pid" ]; then
        kill -0 "$pid" 2>/dev/null && exit 1
        [ ! -e "$PROC_ROOT/$pid" ] || exit 1
    fi
    broray_web_no_private_process || exit 1
    broray_web_evidence "$PIDFILE" WEBUI_PID_INVALID_OR_ABSENT_OWNER || exit 1
    [ ! -L "$PIDFILE" ] && cmp -s "$PIDFILE" "$BRORAY_WEB_EVIDENCE/before" || exit 1
    rm "$PIDFILE" || exit 1
    printf 'action=pid-retired\n' >>"$BRORAY_WEB_EVIDENCE/receipt"
)

broray_web_recover_config()
(
    local seed manifest expected temporary metadata
    [ "$CONF" = "$BASE/config/lighttpd.conf" ] && [ ! -L "$BASE/config" ] && [ ! -L "$CONF" ] || exit 1
    broray_web_config_valid && exit 0
    seed="$BASE/current/state-seed/config/lighttpd.conf"
    manifest="$BASE/current/SHA256SUMS"
    [ ! -L "$BASE/current/state-seed" ] && [ ! -L "$BASE/current/state-seed/config" ] || exit 1
    [ -f "$seed" ] && [ ! -L "$seed" ] && [ -s "$seed" ] &&
        [ -f "$manifest" ] && [ ! -L "$manifest" ] || exit 1
    expected="$(awk '$2=="state-seed/config/lighttpd.conf" {n++;value=$1} END{if(n==1)print value;else exit 1}' "$manifest")" || exit 1
    case "$expected" in ''|*[!0-9a-f]*) exit 1 ;; esac
    [ "${#expected}" = 64 ] && [ "$expected" = "$(sha256sum "$seed" | awk '{print $1}')" ] || exit 1
    [ "$(wc -c <"$seed")" -le 65536 ] || exit 1
    "$RUNTIME_BINARY" -tt -f "$seed" >/dev/null 2>&1 || exit 1
    mkdir "$BASE/run/webui-config-recovery.lock" || exit 1
    temporary=''
    trap '[ -z "$temporary" ] || rm -f "$temporary"; rmdir "$BASE/run/webui-config-recovery.lock"' EXIT
    trap 'exit 1' HUP INT TERM
    broray_web_evidence "$CONF" WEBUI_CONFIG_INVALID || exit 1
    printf 'seedSha256=%s\n' "$expected" >>"$BRORAY_WEB_EVIDENCE/receipt" || exit 1
    umask 077
    temporary="$(mktemp "$BASE/config/.lighttpd-recovery.XXXXXXXX")" || exit 1
    cp "$seed" "$temporary" && chmod 600 "$temporary" && cmp -s "$seed" "$temporary" || exit 1
    [ "$expected" = "$(sha256sum "$temporary" | awk '{print $1}')" ] || exit 1
    "$RUNTIME_BINARY" -tt -f "$temporary" >/dev/null 2>&1 || exit 1
    sync || exit 1
    [ ! -L "$CONF" ] || exit 1
    if [ -f "$BRORAY_WEB_EVIDENCE/before" ]; then
        cmp -s "$CONF" "$BRORAY_WEB_EVIDENCE/before" || exit 1
    else
        [ ! -e "$CONF" ] || exit 1
    fi
    mv -f "$temporary" "$CONF" || exit 1
    temporary=''
    sync || exit 1
    broray_web_config_valid || exit 1
    printf 'action=trusted-seed-restored\n' >>"$BRORAY_WEB_EVIDENCE/receipt"
)

broray_web_reconcile_owned_publish()
(
    # Local availability is independent of KeenDNS. Never create/adopt a proxy
    # during boot; only an existing receipt can enter the ordinary transaction.
    broray_web_http_healthy || exit 1
    [ -f "$BASE/config/web-publish.json" ] && [ ! -L "$BASE/config/web-publish.json" ] || exit 1
    [ -f "$BASE/lib/web-publish.sh" ] && [ ! -L "$BASE/lib/web-publish.sh" ] || exit 1
    [ -f "$BASE/lib/routes-api-operation.sh" ] && [ ! -L "$BASE/lib/routes-api-operation.sh" ] || exit 1
    BRORAY_ROOT="$BASE"; BRORAY_WEB_PUBLISH_ROOT="$BASE"
    . "$BASE/lib/web-publish.sh" || exit 1
    broray_web_publish_owner_record_valid || exit 1
    . "$BASE/lib/routes-api-operation.sh" || exit 1
    broray_routes_api_lock_acquire 'keenetic:web-access-enable' keenetic || exit 1
    trap 'broray_routes_api_lock_release' EXIT
    trap 'exit 1' HUP INT TERM
    # ensure verifies complete live object vs receipt before migrating, then
    # verifies/save/re-reads; its existing exact rollback contract is retained.
    broray_web_publish_ensure
)

broray_web_after_local_ready()
{
    broray_web_reconcile_owned_publish ||
        printf '%s\n' 'WEBUI_LOCAL_READY_PUBLICATION_NOT_CONFIRMED: проверьте раздел KeenDNS в BROray.' >&2
    # A foreign/absent proxy or a busy coordinator must not take local WebUI down.
    return 0
}

start()
{
    local lan pid

    [ -x "$BASE/bin/broray-runtime-prepare" ] || {
        echo "Не найден $BASE/bin/broray-runtime-prepare" >&2
        return 1
    }
    "$BASE/bin/broray-runtime-prepare" >/dev/null || {
        echo "Не удалось подготовить runtime-состояние BROray" >&2
        return 1
    }

    [ -f "$NETWORK" ] && [ ! -L "$NETWORK" ] || {
        echo "Не найден $NETWORK" >&2
        return 1
    }
    BRORAY_NETWORK_ROOT="$BASE"
    . "$NETWORK"
    lan="$(broray_detect_webui_lan_ip)" || return 1

    if [ -e "$PIDFILE" ] || [ -L "$PIDFILE" ]; then
        pid="$(broray_web_pid_read 2>/dev/null || true)"
        if [ -z "$pid" ]; then
            broray_web_retire_invalid_pid || return 1
        else
        if broray_web_process_identity_twice "$pid"; then
            [ "$(broray_web_lan_ip)" = "$lan" ] || {
                echo "Привязка WebUI изменена. Нужен штатный перезапуск; работающий процесс не изменён." >&2
                return 1
            }
            if broray_web_http_healthy; then
                echo "BROray WebUI уже запущен, PID $pid"
                broray_web_after_local_ready
                return 0
            fi
            echo "BROray WebUI PID $pid принадлежит сервису, но HTTP health-check не прошёл." >&2
            return 1
        fi
        if kill -0 "$pid" 2>/dev/null; then
            echo "PID-файл BROray WebUI указывает на чужой живой процесс $pid; файл не изменён." >&2
            return 1
        fi
        broray_web_retire_invalid_pid || return 1
        fi
    fi

    broray_web_no_private_process || return 1
    broray_web_prepare_runtime_binary || return 1
    broray_web_recover_config || return 1
    broray_web_configure_bind "$lan" || return 1
    broray_network_store_lan_ip "$lan" || return 1
    (
        # Rollback may hold the coordinator while preparing runtime above.
        # Only the new daemon loses that verified scope; its parent keeps it.
        if [ -n "${BRORAY_OPS_SCOPE_FD:-}" ]; then
            [ "$BRORAY_OPS_SCOPE_FD" = 6 ] && [ -n "${BRORAY_OPS_SCOPE_LOCK:-}" ] || exit 73
            "${BRORAY_OPS_GUARD:-$BASE/bin/broray-ops-guard}" \
                --assert-held "$BRORAY_OPS_SCOPE_LOCK" || exit 73
            exec 6>&-
            unset BRORAY_OPS_SCOPE_FD BRORAY_OPS_SCOPE_LOCK BRORAY_OPS_GUARD_HELD
        fi
        exec "$RUNTIME_BINARY" -f "$CONF"
    ) || return 1
    sleep 1

    status >/dev/null 2>&1 || {
        echo "Ошибка запуска BROray WebUI" >&2
        sed -n '1,80p' "$LOG" 2>/dev/null >&2 || true
        return 1
    }
    echo "BROray WebUI запущен: http://$lan:8080/"
    broray_web_after_local_ready
}

stop()
{
    local pid attempt

    if [ -e "$BASE/run/web-new/native-auth" ] || [ -L "$BASE/run/web-new/native-auth" ]; then
        [ -f "$NATIVE_AUTH_LIBRARY" ] && [ ! -L "$NATIVE_AUTH_LIBRARY" ] || {
            echo "Не найден безопасный модуль остановки native-auth BROray." >&2
            return 1
        }
        . "$NATIVE_AUTH_LIBRARY"
        broray_native_auth_stop || {
            echo "Native-auth BROray не остановлен; WebUI оставлен без изменений." >&2
            return 1
        }
    fi

    if [ ! -e "$PIDFILE" ] && [ ! -L "$PIDFILE" ]; then
        echo "BROray WebUI не запущен"
        return 0
    fi
    pid="$(broray_web_pid_read 2>/dev/null || true)"
    [ -n "$pid" ] || {
        echo "Некорректный PID-файл BROray WebUI; сигнал не отправлен." >&2
        return 1
    }

    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PIDFILE"
        echo "BROray WebUI уже остановлен"
        return 0
    fi

    # Two full exe+NUL-argv reads immediately precede the only signal. A live
    # PID that fails either read is foreign/ambiguous and is never touched.
    broray_web_process_identity_twice "$pid" || {
        echo "PID $pid не подтверждён как BROray lighttpd; сигнал не отправлен." >&2
        return 1
    }
    kill "$pid" 2>/dev/null || {
        kill -0 "$pid" 2>/dev/null || {
            rm -f "$PIDFILE"
            return 0
        }
        return 1
    }

    attempt=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempt" -lt 5 ]; do
        sleep 1
        attempt=$((attempt + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        if broray_web_process_identity_once "$pid"; then
            echo "BROray WebUI не остановился за 5 секунд; PID-файл сохранён." >&2
            return 1
        fi
        # The original process exited and the numeric PID was reused. Never
        # send a second signal to the new identity.
    fi

    rm -f "$PIDFILE"
    echo "BROray WebUI остановлен"
}

restart()
{
    stop || return 1
    start
}

status()
{
    local pid lan

    pid="$(broray_web_pid_read 2>/dev/null || true)"
    [ -n "$pid" ] && broray_web_process_identity_twice "$pid" || {
        echo "BROray WebUI не запущен или identity неоднозначна"
        return 1
    }
    broray_web_config_valid || return 1
    broray_web_http_healthy || {
        echo "BROray WebUI process identity подтверждена, но HTTP health-check не прошёл"
        return 1
    }
    lan="$(broray_web_lan_ip)" || return 1
    echo "BROray WebUI работает"
    echo "PID: $pid"
    echo "Executable: $RUNTIME_BINARY"
    echo "Адрес: http://$lan:8080/"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status|check) status ;;
    *)
        echo "Использование: $0 {start|stop|restart|status|check}"
        exit 1
        ;;
esac
