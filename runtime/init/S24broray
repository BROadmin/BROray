#!/opt/bin/ash

ENABLED=yes
PROCS=xray
ARGS="run -c /opt/broray/config/config.json"
PREARGS="env XRAY_LOCATION_ASSET=/opt/broray/bin"
broray_lighttpd_guard_maintain()
{
    local guard
    guard=/opt/broray/current/app/lib/lighttpd-guard.sh
    [ -f "$guard" ] && [ ! -L "$guard" ] && [ -x "$guard" ] || return 1
    /opt/bin/ash "$guard" maintain
}

PRECMD=broray_lighttpd_guard_maintain

broray_owned_interface_name()
{
    local owner name suffix

    owner=/opt/broray/config/interface.json
    [ -f "$owner" ] && [ ! -L "$owner" ] || return 1
    /opt/bin/jq -e '
      .owner == "BROray" and
      (.schemaVersion == 1 or .schemaVersion == 2) and
      (.interfaceName | type) == "string"
    ' "$owner" >/dev/null 2>&1 || return 1
    name="$(/opt/bin/jq -r '.interfaceName' "$owner")" || return 1
    case "$name" in
        Proxy*) suffix="${name#Proxy}" ;;
        *) return 1 ;;
    esac
    case "$suffix" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$name"
}

broray_reconnect_owned()
{
    local name ndmc

    name="$(broray_owned_interface_name 2>/dev/null || true)"
    [ -n "$name" ] || return 0
    ndmc="$(command -v ndmc 2>/dev/null || true)"
    [ -n "$ndmc" ] && [ -x "$ndmc" ] || return 1
    "$ndmc" -c "interface $name proxy connect" >/dev/null 2>&1 || return 1
    "$ndmc" -c "interface $name up" >/dev/null 2>&1
}

broray_update_in_progress()
{
    [ -d /opt/var/lock/broray/global-operation.lock ] ||
        [ -d /tmp/broray-global-operation.lock ]
}

broray_process_start_ticks()
{
    local process_pid
    process_pid="$1"
    case "$process_pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    [ -r "/proc/$process_pid/stat" ] || return 1
    sed 's/.*) //' "/proc/$process_pid/stat" 2>/dev/null |
        awk '{print $20; exit}'
}

broray_updater_request_owned()
{
    local state request_lock owner_pid daemon_pid daemon_ready owner_start actual_start operation_id command_line

    state=/opt/var/lib/broray-updater
    request_lock="$state/request.lock"
    [ -d "$request_lock" ] && [ ! -L "$request_lock" ] || return 1
    for file in pid owner-start operation-id
    do
        [ -f "$request_lock/$file" ] && [ ! -L "$request_lock/$file" ] || return 1
    done
    [ -f "$state/daemon.pid" ] && [ ! -L "$state/daemon.pid" ] || return 1
    [ -f "$state/daemon.ready" ] && [ ! -L "$state/daemon.ready" ] || return 1

    owner_pid="$(sed -n '1p' "$request_lock/pid" 2>/dev/null || true)"
    daemon_pid="$(sed -n '1p' "$state/daemon.pid" 2>/dev/null || true)"
    daemon_ready="$(sed -n '1p' "$state/daemon.ready" 2>/dev/null || true)"
    owner_start="$(sed -n '1p' "$request_lock/owner-start" 2>/dev/null || true)"
    operation_id="$(sed -n '1p' "$request_lock/operation-id" 2>/dev/null || true)"
    case "$owner_pid:$daemon_pid:$daemon_ready:$owner_start" in
        *[!0-9:]*) return 1 ;;
    esac
    [ -n "$owner_pid" ] && [ "$owner_pid" = "$daemon_pid" ] && [ "$owner_pid" = "$daemon_ready" ] || return 1
    case "$operation_id" in
        update-*|reinstall-*) ;;
        *) return 1 ;;
    esac
    case "$operation_id" in
        ''|.*|-*|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    kill -0 "$owner_pid" 2>/dev/null || return 1
    actual_start="$(broray_process_start_ticks "$owner_pid" 2>/dev/null || true)"
    [ -n "$actual_start" ] && [ "$actual_start" = "$owner_start" ] || return 1
    [ -r "/proc/$owner_pid/cmdline" ] || return 1
    command_line="$(tr '\000' ' ' <"/proc/$owner_pid/cmdline" 2>/dev/null || true)"
    case "$command_line" in
        *broray-updater*daemon*) return 0 ;;
    esac
    return 1
}

broray_reconcile_status_write()
{
    local state attempt method target temporary
    state="$1"
    attempt="$2"
    method="$3"
    target=/opt/broray/run/interface-reconcile.status
    temporary="$target.tmp.$$"
    umask 077
    mkdir -p /opt/broray/run || return 1
    {
        printf 'state=%s\n' "$state"
        printf 'attempt=%s\n' "$attempt"
        printf 'method=%s\n' "$method"
    } >"$temporary" || return 1
    mv -f "$temporary" "$target"
}

broray_reconcile_owned_for_update()
{
    local interface_script

    broray_owned_interface_name >/dev/null 2>&1 || return 0
    interface_script=/opt/broray/current/app/lib/interface.sh
    [ -r "$interface_script" ] || return 1
    broray_reconcile_stop || return 1
    if BRORAY_BASE=/opt/broray /opt/bin/ash "$interface_script" sync-name >/dev/null 2>&1 &&
       BRORAY_BASE=/opt/broray /opt/bin/ash "$interface_script" check >/dev/null 2>&1
    then
        broray_reconcile_status_write success 1 sync-name-update || true
        return 0
    fi
    broray_reconcile_status_write error 1 sync-name-update || true
    return 1
}

POSTCMD=broray_reconnect_owned
DESC="BROray"
PATH=/opt/broray/bin:/opt/sbin:/opt/bin:/sbin:/bin

broray_subscription_scheduler_start()
{
    local service
    service=/opt/etc/init.d/S28broray-subscriptions
    [ -f "$service" ] || [ -L "$service" ] || return 1
    /opt/bin/ash "$service" start >/dev/null 2>&1
}

# Keep Entware rc.func unchanged; narrow its process operations in this service.
BRORAY_XRAY_BINARY=/opt/broray/runtime/xray
BRORAY_XRAY_CONFIG=/opt/broray/config/config.json
. /opt/broray/current/app/lib/xray-process.sh || exit 1
pidof() {
    if [ "$#" = 1 ] && [ "$1" = xray ]; then
        broray_xray_runtime_pids
    else
        command pidof "$@"
    fi
}
killall() {
    case "$*" in
        xray) broray_xray_runtime_signal TERM ;;
        '-9 xray') broray_xray_runtime_signal 9 ;;
        '-SIGHUP xray') broray_xray_runtime_signal SIGHUP ;;
        *) command killall "$@" ;;
    esac
}
# Refuse an ambiguous sidecar before stopping the persistent runtime.
. "${BRORAY_ROOT:-/opt/broray}/lib/startup-sidecars.sh" || exit 74
case "${1:-}" in
    stop|kill|restart)
        broray_reconcile_stop || exit $?
        broray_home_snapshot_stop || exit $? ;;
esac
. /opt/etc/init.d/rc.func
# rc.func does not propagate failures consistently. Check the actual runtime
# before starting sidecars or reporting success, including the stopped state.
case "$ACTION" in
    start|restart|status|check|reconfigure) broray_xray_runtime_pid >/dev/null || exit 1 ;;
    stop|kill) if broray_xray_runtime_pid >/dev/null; then exit 1; fi ;;
esac

case "$ACTION" in
    start)
        if broray_updater_request_owned; then
            broray_reconcile_owned_for_update || exit 1
        elif [ "${BRORAY_STARTUP_RECONCILE_SKIP:-0}" = 1 ] || broray_update_in_progress; then
            broray_reconcile_stop || exit $?
        else
            broray_reconcile_owned || exit $?
        fi
        broray_home_snapshot_start || exit 1
        broray_subscription_scheduler_start || exit 1
        ;;
    restart)
        broray_home_snapshot_start || exit 1
        broray_subscription_scheduler_start || exit 1
        ;;
    status)
        broray_home_snapshot_running || exit 1
        ;;
esac
exit 0
