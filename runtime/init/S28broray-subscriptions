#!/opt/bin/ash
set -u

PATH="/opt/broray/bin:/opt/sbin:/opt/bin:/sbin:/bin"
export PATH

ROOT="${BRORAY_ROOT:-/opt/broray}"
DAEMON="${BRORAY_SUBSCRIPTION_SCHEDULER:-$ROOT/bin/broray-subscription-scheduler}"
RUN_DIR="${BRORAY_SUBSCRIPTION_RUN_DIR:-$ROOT/run}"
PIDFILE="${BRORAY_SUBSCRIPTION_PIDFILE:-$RUN_DIR/subscription-scheduler.pid}"
STARTTIME_FILE="${BRORAY_SUBSCRIPTION_STARTTIME_FILE:-$RUN_DIR/subscription-scheduler.starttime}"
START_LOCK="${BRORAY_SUBSCRIPTION_START_LOCK:-$RUN_DIR/subscription-scheduler.start.lock}"
LOG_FILE="${BRORAY_SUBSCRIPTION_SERVICE_LOG:-$ROOT/logs/subscription-scheduler.log}"
PROC_ROOT="${BRORAY_SUBSCRIPTION_PROC_ROOT:-/proc}"

# BROray subscription scheduler singleton v3.
# Only the authoritative PID plus kernel process start time is inspected.  A
# global /proc cmdline scan is deliberately forbidden because helper shells
# inherit the daemon pathname and were previously counted as extra instances.
process_starttime()
{
    identity_pid="$1"
    awk 'NR==1 { print $22; exit }' "$PROC_ROOT/$identity_pid/stat" 2>/dev/null
}

process_identity_matches()
{
    identity_pid="$1"
    identity_start="$2"
    case "$identity_pid:$identity_start" in
        *[!0-9:]*|:|*:) return 1 ;;
    esac
    kill -0 "$identity_pid" 2>/dev/null || return 1
    [ "$(process_starttime "$identity_pid")" = "$identity_start" ]
}

scheduler_identity_matches()
{
    identity_pid="$1"
    identity_start="$2"
    process_identity_matches "$identity_pid" "$identity_start" || return 1
    [ -r "$PROC_ROOT/$identity_pid/cmdline" ] || return 1
    identity_command="$(tr '\000' ' ' <"$PROC_ROOT/$identity_pid/cmdline" 2>/dev/null)"
    case "$identity_command" in
        *"$DAEMON"*) return 0 ;;
    esac
    return 1
}

read_identity()
{
    TRACKED_PID="$(sed -n '1p' "$PIDFILE" 2>/dev/null)"
    TRACKED_START="$(sed -n '1p' "$STARTTIME_FILE" 2>/dev/null)"
}

write_one()
{
    identity_path="$1"
    identity_value="$2"
    identity_temporary="$identity_path.new.$$"
    printf '%s\n' "$identity_value" >"$identity_temporary" || return 1
    chmod 600 "$identity_temporary" 2>/dev/null || true
    mv -f "$identity_temporary" "$identity_path"
}

write_identity()
{
    identity_pid="$1"
    identity_start="$2"
    mkdir -p "$RUN_DIR" || return 1
    write_one "$PIDFILE" "$identity_pid" || return 1
    write_one "$STARTTIME_FILE" "$identity_start" || return 1
}

clear_identity()
{
    rm -f "$PIDFILE" "$STARTTIME_FILE" \
        "$PIDFILE.new.$$" "$STARTTIME_FILE.new.$$"
}

release_start_lock()
{
    [ -d "$START_LOCK" ] || return 0
    lock_pid="$(sed -n '1p' "$START_LOCK/pid" 2>/dev/null)"
    lock_start="$(sed -n '1p' "$START_LOCK/starttime" 2>/dev/null)"
    self_start="$(process_starttime "$$")"
    if [ "$lock_pid" = "$$" ] && [ -n "$self_start" ] && [ "$lock_start" = "$self_start" ]; then
        rm -rf "$START_LOCK"
    fi
}

acquire_start_lock()
{
    mkdir -p "$RUN_DIR" || return 1
    if ! mkdir "$START_LOCK" 2>/dev/null; then
        lock_pid="$(sed -n '1p' "$START_LOCK/pid" 2>/dev/null)"
        lock_start="$(sed -n '1p' "$START_LOCK/starttime" 2>/dev/null)"
        process_identity_matches "$lock_pid" "$lock_start" && return 1
        rm -rf "$START_LOCK" || return 1
        mkdir "$START_LOCK" 2>/dev/null || return 1
    fi
    self_start="$(process_starttime "$$")"
    [ -n "$self_start" ] || {
        rm -rf "$START_LOCK"
        return 1
    }
    printf '%s\n' "$$" >"$START_LOCK/pid" || return 1
    printf '%s\n' "$self_start" >"$START_LOCK/starttime" || return 1
}

status_service()
{
    read_identity
    if scheduler_identity_matches "$TRACKED_PID" "$TRACKED_START"; then
        printf 'running pid=%s starttime=%s\n' "$TRACKED_PID" "$TRACKED_START"
        return 0
    fi
    clear_identity
    printf '%s\n' 'stopped'
    return 1
}

stop_service()
{
    read_identity
    if ! scheduler_identity_matches "$TRACKED_PID" "$TRACKED_START"; then
        clear_identity
        return 0
    fi

    kill "$TRACKED_PID" 2>/dev/null || true
    for wait_round in 1 2 3 4 5; do
        scheduler_identity_matches "$TRACKED_PID" "$TRACKED_START" || break
        sleep 1
    done
    if scheduler_identity_matches "$TRACKED_PID" "$TRACKED_START"; then
        kill -9 "$TRACKED_PID" 2>/dev/null || true
        sleep 1
    fi
    scheduler_identity_matches "$TRACKED_PID" "$TRACKED_START" && return 1
    clear_identity
    return 0
}

start_service()
{
    [ -x "$DAEMON" ] || {
        printf 'ОШИБКА: отсутствует %s\n' "$DAEMON" >&2
        return 1
    }
    if status_service >/dev/null 2>&1; then
        status_service
        return 0
    fi
    acquire_start_lock || {
        printf '%s\n' 'ОШИБКА: запуск scheduler уже выполняется' >&2
        return 1
    }
    trap 'release_start_lock' EXIT HUP INT TERM

    if status_service >/dev/null 2>&1; then
        release_start_lock
        trap - EXIT HUP INT TERM
        status_service
        return 0
    fi
    clear_identity
    mkdir -p "$RUN_DIR" "$(dirname "$LOG_FILE")" || return 1

    BRORAY_SUBSCRIPTION_PIDFILE="$PIDFILE" \
    BRORAY_SUBSCRIPTION_STARTTIME_FILE="$STARTTIME_FILE" \
    BRORAY_SUBSCRIPTION_LOG_FILE="$LOG_FILE" \
    BRORAY_SUBSCRIPTION_PROC_ROOT="$PROC_ROOT" \
        "$DAEMON" >>"$LOG_FILE" 2>&1 </dev/null &
    launched="$!"
    sleep 1
    launched_start="$(process_starttime "$launched")"
    if [ -z "$launched_start" ] || ! scheduler_identity_matches "$launched" "$launched_start"; then
        clear_identity
        release_start_lock
        trap - EXIT HUP INT TERM
        printf '%s\n' 'ОШИБКА: scheduler не запущен с подтверждённой идентичностью' >&2
        return 1
    fi
    write_identity "$launched" "$launched_start" || {
        kill "$launched" 2>/dev/null || true
        release_start_lock
        trap - EXIT HUP INT TERM
        return 1
    }
    release_start_lock
    trap - EXIT HUP INT TERM
    status_service
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service && start_service ;;
    status) status_service ;;
    *)
        printf '%s\n' 'Использование: S28broray-subscriptions {start|stop|restart|status}' >&2
        exit 2
        ;;
esac
