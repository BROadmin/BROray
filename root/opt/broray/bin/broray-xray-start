#!/bin/sh

CONFIG="/opt/broray/config/config.json"
SETTINGS="/opt/broray/config/system/settings.json"
ROUTE_STATE="/opt/broray/run/xray-server-route"
XRAY="/opt/broray/bin/xray"

log()
{
    logger -t BROray "$*" 2>/dev/null || true
    echo "BROray: $*" >&2
}

server_host="$(
    jq -r '
        first(
            .outbounds[]?
            | select(
                .protocol == "hysteria"
                or
                .protocol == "hysteria2"
            )
            | (
                .settings.address
                //
                .settings.servers[0].address
                //
                empty
            )
        ) // empty
    ' "$CONFIG"
)"

if [ -z "$server_host" ]; then
    log "Hysteria server address was not found in $CONFIG"
    exit 1
fi

wan_if="$(
    jq -r '
        .routing.wanInterface
        // empty
    ' "$SETTINGS" 2>/dev/null
)"

if [ -z "$wan_if" ]; then
    log "WAN interface is not configured"
    exit 1
fi

wait_count=0

while ! ip link show "$wan_if" >/dev/null 2>&1; do
    wait_count=$((wait_count + 1))

    if [ "$wait_count" -ge 30 ]; then
        log "WAN interface $wan_if is unavailable"
        exit 1
    fi

    sleep 1
done

server_ip="$(
    nslookup "$server_host" 2>/dev/null |
    awk '
        /^Address [0-9]+: / {
            ip=$3
            sub(/#.*/, "", ip)

            if (
                ip ~
                /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/
            ) {
                result=ip
            }
        }

        /^Address: / {
            ip=$2
            sub(/#.*/, "", ip)

            if (
                ip ~
                /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/
            ) {
                result=ip
            }
        }

        END {
            print result
        }
    '
)"

if [ -z "$server_ip" ]; then
    log "Cannot resolve IPv4 address for $server_host"
    exit 1
fi

previous_ip=""
previous_if=""

if [ -f "$ROUTE_STATE" ]; then
    read previous_ip previous_if < "$ROUTE_STATE"

    if [ "$previous_ip" != "$server_ip" ] ||
       [ "$previous_if" != "$wan_if" ]; then
        ip route del "$previous_ip/32" \
            dev "$previous_if" \
            2>/dev/null || true
    fi
fi

default_route="$(
    ip route show table all |
    awk -v interface="$wan_if" '
        $1 == "default" {
            for (i=1; i<=NF; i++) {
                if (
                    $i == "dev"
                    &&
                    $(i+1) == interface
                ) {
                    print
                    exit
                }
            }
        }
    '
)"

gateway="$(
    echo "$default_route" |
    awk '
        {
            for (i=1; i<=NF; i++) {
                if ($i == "via") {
                    print $(i+1)
                    exit
                }
            }
        }
    '
)"

if [ -n "$gateway" ]; then
    ip route replace "$server_ip/32" \
        via "$gateway" \
        dev "$wan_if" \
        metric 1
else
    ip route replace "$server_ip/32" \
        dev "$wan_if" \
        metric 1
fi

printf '%s %s\n' \
    "$server_ip" \
    "$wan_if" \
    > "$ROUTE_STATE"

actual_route="$(
    ip route get "$server_ip" 2>/dev/null |
    head -n 1
)"

case "$actual_route" in
    *" dev $wan_if "*|*" dev $wan_if")
        log "Server $server_host ($server_ip) routed through $wan_if"
        ;;
    *)
        log "Failed to route $server_ip through $wan_if: $actual_route"
        exit 1
        ;;
esac

export XRAY_LOCATION_ASSET="/opt/broray/bin"

exec "$XRAY" run -c "$CONFIG"
